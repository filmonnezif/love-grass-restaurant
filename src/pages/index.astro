---
import BaseLayout from '../layouts/BaseLayout.astro';
import menuData from '../data/menu.json';
import reviewsData from '../data/reviews.json';
import { Image } from 'astro:assets';

import loveGrassSpecialImg from '../assets/food/love-grass-special.png';
import specialKitfoImg from '../assets/food/special-kitfo.png';
import maheberawiImg from '../assets/food/maheberawi.png';
import derekTibsImg from '../assets/food/derek-tibs.png';
import teffCakeImg from '../assets/food/teff-cake.png';
import teffBerryDelightImg from '../assets/food/teff-berry-delight.png';

const foodImages: Record<string, ImageMetadata> = {
  'love-grass-special.png': loveGrassSpecialImg,
  'special-kitfo.png': specialKitfoImg,
  'maheberawi.png': maheberawiImg,
  'derek-tibs.png': derekTibsImg,
  'teff-cake.png': teffCakeImg,
  'teff-berry-delight.png': teffBerryDelightImg,
};

import atmosphere1Poster from '../assets/atmosphere/posters/atmosphere-1.webp';
import atmosphere2Poster from '../assets/atmosphere/posters/atmosphere-2.webp';
import atmosphere3Poster from '../assets/atmosphere/posters/atmosphere-3.webp';
import atmosphere4Poster from '../assets/atmosphere/posters/atmosphere-4.webp';
import atmosphere5Poster from '../assets/atmosphere/posters/atmosphere-5.webp';
import atmosphere6Poster from '../assets/atmosphere/posters/atmosphere-6.webp';

const atmosphereItems = [
  {
    id: 'atmosphere-1',
    title: 'A Special Visit from Neway Debebe',
    amharic: 'የነዋይ ደበበ ልዩ ጉብኝት',
    poster: atmosphere1Poster,
  },
  {
    id: 'atmosphere-2',
    title: 'An Emirati Guest Enjoys Derek Tibs',
    amharic: 'ኢሚሬታዊ እንግዳ ደረቅ ጥብስ ሲቀምስ',
    poster: atmosphere2Poster,
  },
  {
    id: 'atmosphere-3',
    title: 'Families Gather Around Ethiopian Favorites',
    amharic: 'ቤተሰቦች በአንድ ማዕድ',
    poster: atmosphere3Poster,
  },
  {
    id: 'atmosphere-4',
    title: "An Emirati Family's Ethiopian Feast",
    amharic: 'የኢሚሬታዊ ቤተሰብ የኢትዮጵያ ማዕድ',
    poster: atmosphere4Poster,
  },
  {
    id: 'atmosphere-5',
    title: 'A Joyful Ethiopian Wedding Celebration',
    amharic: 'ደማቅ የኢትዮጵያ ሰርግ',
    poster: atmosphere5Poster,
  },
  {
    id: 'atmosphere-6',
    title: 'Mahberawi, Made for Sharing',
    amharic: 'ለመጋራት የቀረበ ማህበራዊ',
    poster: atmosphere6Poster,
  },
];

/* Compute aggregate rating for schema */
const allRatings = reviewsData.map(r => r.rating);
const avgRating = (allRatings.reduce((a, b) => a + b, 0) / allRatings.length).toFixed(1);

const aggregateRatingSchema = {
  "@context": "https://schema.org",
  "@type": "Restaurant",
  "name": "Love Grass Restaurant",
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": avgRating,
    "bestRating": "5",
    "worstRating": "1",
    "ratingCount": String(allRatings.length)
  }
};

/* Featured items (tagged as 'popular' or 'signature') */
const featuredItems = menuData.sections
  .flatMap(s => s.items)
  .filter(item => item.tags.includes('popular') || item.tags.includes('signature'))
  .slice(0, 6);

/* Star SVG helper */
const starSVG = `<svg width="16" height="16" viewBox="0 0 24 24" fill="var(--color-star)" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>`;
---

<BaseLayout
  title="Love Grass Restaurant"
  description="Authentic Ethiopian restaurant in Dubai serving homemade teff injera, Tibs, Kitfo, Doro Wot, and traditional dishes. Experience the flavors of Ethiopia."
  schema={aggregateRatingSchema}
>

  <!-- ========== HERO SECTION ========== -->
  <section class="hero" id="hero" aria-label="Welcome to Love Grass Restaurant">
    <div class="hero__layout container">
      <div class="hero__visual" aria-hidden="true">
        <div class="hero__lottie" id="hero-lottie-container"></div>
      </div>

      <div class="hero__content">
        <p class="hero__label font-accent">From grain to table</p>
        <h1 class="hero__title">Ethiopian tradition, served warm in Dubai.</h1>
        <p class="hero__description">
          Fresh teff injera and time-honoured dishes, made for sharing around one table.
        </p>

        <div class="hero__actions">
          <a href="/menu" class="btn btn--accent btn--lg">
            Explore Our Menu
          </a>
          <a href="#featured" class="hero__scroll-cue" aria-label="Scroll to our signature dishes">
            <span>Discover our dishes</span>
            <svg viewBox="0 0 24 32" aria-hidden="true">
              <path d="M12 2v25M4 19l8 9 8-9"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== FEATURED PRODUCTS ========== -->
  <section class="section featured" id="featured" aria-labelledby="featured-title">
    <div class="container" data-featured-showcase>
      <header class="featured__header" data-reveal>
        <div class="featured__intro">
          <p class="section-label">Our Specialties</p>
          <h2 class="section-title" id="featured-title">Signature Dishes</h2>
          <p class="featured__subtitle">Six favourites, made for sharing around one table.</p>
        </div>
      </header>

      <ul
        class="featured-rail"
        aria-label="Signature dishes"
        tabindex="0"
        data-featured-rail
        data-reveal
        data-reveal-delay="1"
      >
        {featuredItems.map((item, i) => (
          <li class="featured-rail__item" data-featured-card>
            <article class="featured-card">
              <span class="featured-card__number" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>

              <div class="featured-card__visual">
                {foodImages[item.image] ? (
                  <Image
                    src={foodImages[item.image]}
                    alt={item.name}
                    width={540}
                    height={540}
                    loading={i < 3 ? 'eager' : 'lazy'}
                    decoding="async"
                    class:list={[
                      'featured-card__image',
                      { 'featured-card__image--derek-tibs': item.id === 'derek-tibs' },
                      { 'featured-card__image--teff-cake': item.id === 'teff-cake' },
                    ]}
                  />
                ) : (
                  <div class="featured-card__placeholder" aria-label={item.name}>
                    <span class="font-ethiopic">{item.nameAmharic}</span>
                  </div>
                )}
              </div>

              <div class="featured-card__body">
                <p class="font-ethiopic featured-card__amharic">{item.nameAmharic}</p>
                <div class="featured-card__heading">
                  <h3 class="featured-card__name">{item.name}</h3>
                  <span class="featured-card__price">
                    <span>AED</span> {item.price}
                  </span>
                </div>
                <p class="featured-card__desc">{item.description}</p>
                <div class="featured-card__tags">
                  {item.dietary.map(tag => <span class="dietary-tag">{tag}</span>)}
                </div>
              </div>
            </article>
          </li>
        ))}
      </ul>

      <div class="featured__footer" data-reveal data-reveal-delay="2">
        <a href="/menu" class="featured__footer-link">
          <span>View Full Menu</span>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 12h14M14 7l5 5-5 5"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ========== ATMOSPHERE ========== -->
  <section class="section atmosphere" id="atmosphere" aria-labelledby="atmosphere-title">
    <div class="container">
      <div class="text-center" data-reveal>
        <p class="section-label">The Experience</p>
        <h2 class="section-title" id="atmosphere-title">Our Atmosphere</h2>
        <hr class="divider" style="margin-inline: auto;" />
        <p class="section-subtitle" style="margin-inline: auto;">
          A warm, welcoming space where every meal feels like a gathering with family
        </p>
      </div>

      <div
        class="atmosphere-carousel"
        data-atmosphere-grid
        data-reveal
        role="group"
        aria-roledescription="carousel"
        aria-label="Atmosphere videos"
      >
        <div class="atmosphere-carousel__track" data-atmosphere-track>
          {atmosphereItems.map((item, i) => (
            <button
              type="button"
              class:list={['atmosphere-card', { 'is-active': i === 0 }]}
              data-atmosphere-card
              data-atmosphere-index={String(i)}
              aria-label={`Show ${item.title}`}
              aria-pressed={i === 0 ? 'true' : 'false'}
            >
              <div class="atmosphere-card__media">
                <Image
                  src={item.poster}
                  alt={item.title}
                  width={540}
                  height={960}
                  loading="lazy"
                  decoding="async"
                  class="atmosphere-card__poster"
                />
                <video
                  class="atmosphere-card__video"
                  loop
                  muted
                  playsinline
                  preload="none"
                  aria-hidden="true"
                >
                  <source src={`/videos/atmosphere/${item.id}.webm`} type="video/webm" />
                  <source src={`/videos/atmosphere/${item.id}.mp4`} type="video/mp4" />
                </video>
                <div class="atmosphere-card__overlay">
                  <span class="font-ethiopic atmosphere-card__amharic">{item.amharic}</span>
                  <h3 class="atmosphere-card__title">{item.title}</h3>
                </div>
              </div>
            </button>
          ))}
        </div>
      </div>

      <p class="sr-only" data-atmosphere-status aria-live="polite"></p>
    </div>
  </section>

  <!-- ========== GOOGLE REVIEWS ========== -->
  <section class="section reviews" id="reviews" aria-labelledby="reviews-title">
    <div class="container">
      <div class="text-center" data-reveal>
        <p class="section-label">What People Say</p>
        <h2 class="section-title" id="reviews-title">Our Reviews</h2>
        <hr class="divider" style="margin-inline: auto;" />
        <div class="reviews-rating">
          <div class="reviews-stars" aria-label={`Rated ${avgRating} out of 5 stars`}>
            {Array.from({ length: 5 }).map(() => (
              <Fragment set:html={starSVG} />
            ))}
          </div>
          <span class="reviews-avg">{avgRating}</span>
          <span class="text-muted text-sm">based on {reviewsData.length} reviews</span>
        </div>
      </div>

      <div class="reviews-grid">
        {reviewsData.map((review, i) => (
          <article class="review-card card" data-reveal data-reveal-delay={String(Math.min(i + 1, 5))}>
            <div class="review-card__stars" aria-label={`${review.rating} stars`}>
              {Array.from({ length: review.rating }).map(() => (
                <Fragment set:html={starSVG} />
              ))}
            </div>
            <blockquote class="review-card__text">
              <p>"{review.text}"</p>
            </blockquote>
            <footer class="review-card__footer">
              <cite class="review-card__author">{review.author}</cite>
              <span class="review-card__source">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"></path>
                  <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"></path>
                  <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"></path>
                  <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"></path>
                </svg>
                {review.source}
              </span>
            </footer>
          </article>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ========== HERO ========== */
  .hero {
    position: relative;
    min-height: calc(100svh - 64px);
    overflow: hidden;
    background:
      radial-gradient(circle at 18% 15%, rgba(76, 175, 80, 0.2), transparent 34rem),
      linear-gradient(145deg, var(--color-primary) 0%, var(--color-primary-dark) 78%);
  }

  .hero__layout {
    min-height: inherit;
    display: grid;
    grid-template-rows: minmax(260px, 38svh) auto;
    align-items: center;
    padding-block: var(--space-3) var(--space-6);
  }

  .hero__visual {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 260px;
    overflow: visible;
  }

  .hero__visual::after {
    content: '';
    position: absolute;
    inset: auto 3% -3% 3%;
    height: 18%;
    border-radius: 50%;
    background: rgba(12, 42, 14, 0.38);
    filter: blur(24px);
    pointer-events: none;
  }

  .hero__lottie {
    position: absolute;
    inset: 2% -24% -36%;
    transform: scale(0.8);
    transform-origin: center;
  }

  .hero__lottie :global(canvas) {
    width: 100% !important;
    height: 100% !important;
    max-width: none;
    object-fit: contain;
  }

  .hero__content {
    position: relative;
    width: 100%;
    padding-top: var(--space-2);
    text-align: center;
  }

  .hero__label {
    font-size: var(--text-lg);
    color: var(--color-accent-light);
    margin-bottom: var(--space-2);
  }

  .hero__title {
    max-width: 15ch;
    margin-inline: auto;
    font-family: var(--font-heading);
    font-size: clamp(2.25rem, 9vw, 3.5rem);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.035em;
    color: var(--color-text-inverse);
  }

  .hero__description {
    max-width: 36ch;
    margin: var(--space-3) auto 0;
    color: rgba(255, 255, 255, 0.82);
    font-size: var(--text-base);
    line-height: 1.65;
  }

  .hero__actions {
    min-height: 56px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-3);
    justify-content: center;
  }

  .hero__scroll-cue {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-accent-light);
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero__scroll-cue svg {
    width: 18px;
    height: 24px;
    overflow: visible;
    animation: scroll-cue-bob 2.4s var(--ease-in-out) infinite;
  }

  .hero__scroll-cue path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @keyframes scroll-cue-bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(3px); }
  }

  @media (max-width: 420px) {
    .hero__layout {
      grid-template-rows: minmax(230px, 36svh) auto;
      padding-inline: var(--space-3);
    }

    .hero__visual {
      min-height: 230px;
    }

    .hero__scroll-cue span {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
  }

  @media (min-width: 900px) {
    .hero {
      min-height: calc(100svh - 72px);
    }

    .hero__layout {
      grid-template-columns: minmax(0, 58%) minmax(0, 42%);
      grid-template-rows: 1fr;
      gap: 0;
      padding-block: var(--space-5);
    }

    .hero__visual {
      min-height: min(74svh, 720px);
    }

    .hero__lottie {
      inset: -4% -4% -14% -14%;
      transform: translateY(-4%) scale(0.8);
    }

    .hero__content {
      padding-top: 0;
      text-align: left;
      transform: translateX(clamp(-3rem, -3vw, -1.5rem));
    }

    .hero__label {
      text-align: left;
    }

    .hero__title,
    .hero__description {
      margin-inline: 0;
    }

    .hero__title {
      font-size: clamp(3rem, 5vw, 4.5rem);
    }

    .hero__actions {
      flex-direction: row;
      justify-content: flex-start;
      align-items: center;
    }
  }

  @media (min-width: 1200px) {
    .hero__layout {
      grid-template-columns: minmax(0, 60%) minmax(0, 40%);
    }
  }

  /* ========== FEATURED PRODUCTS ========== */
  .featured {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background:
      radial-gradient(circle at 78% 38%, rgba(92, 171, 80, 0.42), transparent 31rem),
      radial-gradient(circle at 8% 100%, rgba(232, 184, 109, 0.12), transparent 30rem),
      linear-gradient(145deg, var(--color-primary) 0%, var(--color-primary-dark) 78%);
    color: var(--color-text-inverse);
  }

  .featured::before {
    content: '';
    position: absolute;
    z-index: -1;
    width: min(70vw, 820px);
    aspect-ratio: 1;
    right: -18%;
    top: 4%;
    border-radius: 50%;
    opacity: 0.12;
    background: repeating-radial-gradient(
      circle,
      transparent 0 18px,
      rgba(255, 255, 255, 0.75) 19px 20px
    );
    mask-image: radial-gradient(circle, #000 28%, transparent 72%);
    pointer-events: none;
  }

  .featured__shell {
    display: grid;
    grid-template-areas:
      'intro'
      'stage'
      'selector'
      'cta';
    gap: var(--space-5);
  }

  .featured__intro {
    grid-area: intro;
  }

  .featured .section-label {
    color: var(--color-accent-light);
  }

  .featured .section-title {
    max-width: 9ch;
    color: var(--color-text-inverse);
  }

  .featured .divider {
    margin-inline: 0;
    background: var(--color-accent-light);
  }

  .featured__subtitle {
    max-width: 27ch;
    color: rgba(255, 255, 255, 0.76);
    font-size: var(--text-lg);
    line-height: 1.65;
  }

  .featured-selector {
    grid-area: selector;
    min-width: 0;
  }

  .featured-selector__heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-3);
    color: rgba(255, 255, 255, 0.58);
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .featured-autoplay {
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: var(--radius-full);
    color: var(--color-text-inverse);
    transition: background-color var(--duration-fast), border-color var(--duration-fast);
  }

  .featured-autoplay:hover {
    border-color: var(--color-accent-light);
    background: rgba(255, 255, 255, 0.1);
  }

  .featured-autoplay svg {
    width: 17px;
    height: 17px;
  }

  .featured-autoplay path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .featured-autoplay__play,
  .featured-autoplay[aria-pressed='true'] .featured-autoplay__pause {
    display: none;
  }

  .featured-autoplay[aria-pressed='true'] .featured-autoplay__play {
    display: block;
  }

  .featured-selector__list {
    display: flex;
    gap: var(--space-2);
    margin-inline: calc(var(--gutter) * -1);
    padding-inline: var(--gutter);
    padding-bottom: var(--space-2);
    overflow-x: auto;
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.35) transparent;
    scroll-snap-type: x proximity;
  }

  .featured-selector__item {
    position: relative;
    flex: 0 0 auto;
    display: grid;
    grid-template-columns: auto auto;
    align-items: center;
    gap: var(--space-2);
    min-height: 48px;
    padding: var(--space-2) var(--space-3);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-full);
    color: rgba(255, 255, 255, 0.72);
    scroll-snap-align: start;
    transition:
      color var(--duration-fast),
      background-color var(--duration-fast),
      border-color var(--duration-fast);
  }

  .featured-selector__item:hover,
  .featured-selector__item.is-active {
    color: var(--color-text-inverse);
    border-color: var(--color-accent-light);
    background: rgba(255, 255, 255, 0.1);
  }

  .featured-selector__item:focus-visible,
  .featured-autoplay:focus-visible {
    outline: 3px solid var(--color-accent-light);
    outline-offset: 3px;
  }

  .featured-selector__number {
    color: var(--color-accent-light);
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
  }

  .featured-selector__name {
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 600;
    white-space: nowrap;
  }

  .featured-selector__marker {
    display: none;
  }

  .featured-stage {
    grid-area: stage;
    position: relative;
    display: grid;
    min-width: 0;
    min-height: 580px;
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: var(--radius-xl);
    background: rgba(15, 61, 25, 0.22);
    box-shadow: inset 0 1px rgba(255, 255, 255, 0.08), var(--shadow-xl);
    overflow: hidden;
  }

  .featured-dish {
    grid-area: 1 / 1;
    position: relative;
    display: grid;
    grid-template-rows: minmax(330px, 1fr) auto;
    width: 100%;
    height: 100%;
    padding: var(--space-3);
    opacity: 0;
    visibility: hidden;
    transform: scale(0.985);
    transition:
      opacity var(--duration-normal) var(--ease-out),
      transform var(--duration-normal) var(--ease-out),
      visibility 0s linear var(--duration-normal);
  }

  .featured-dish.is-active {
    opacity: 1;
    visibility: visible;
    transform: scale(1);
    transition-delay: 0s;
  }

  .featured-dish__ghost-number {
    position: absolute;
    top: -0.14em;
    right: 0.04em;
    color: rgba(255, 255, 255, 0.08);
    font-family: var(--font-heading);
    font-size: clamp(8rem, 32vw, 15rem);
    font-weight: 700;
    line-height: 1;
    pointer-events: none;
  }

  .featured-dish__visual {
    position: relative;
    z-index: 1;
    min-height: 0;
    display: grid;
    place-items: center;
  }

  .featured-dish__image {
    width: min(100%, 560px);
    height: auto;
    aspect-ratio: 1;
    object-fit: contain;
    filter: drop-shadow(0 22px 28px rgba(8, 35, 13, 0.35));
    mask-image: radial-gradient(circle at 50% 48%, #000 49%, rgba(0, 0, 0, 0.95) 60%, transparent 72%);
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .featured-dish.is-active .featured-dish__image {
    animation: featured-dish-arrive 700ms var(--ease-out) both;
  }

  @keyframes featured-dish-arrive {
    from { transform: translateY(10px) scale(0.96) rotate(-1deg); }
    to { transform: translateY(0) scale(1) rotate(0); }
  }

  .featured-dish__placeholder {
    width: min(82%, 480px);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    color: var(--color-accent-light);
    font-size: var(--text-2xl);
  }

  .featured-dish__details {
    position: relative;
    z-index: 2;
    min-height: 190px;
    padding: var(--space-4);
    border-radius: var(--radius-lg);
    background: rgba(18, 54, 23, 0.78);
    backdrop-filter: blur(12px);
  }

  .featured-dish__heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .featured-dish__amharic {
    margin-bottom: 2px;
    color: var(--color-accent-light);
    font-size: var(--text-sm);
  }

  .featured-dish__name {
    color: var(--color-text-inverse);
    font-size: var(--text-2xl);
  }

  .featured-dish .price {
    flex: 0 0 auto;
    color: var(--color-accent-light);
    font-size: var(--text-xl);
  }

  .featured-dish .price-currency {
    color: rgba(255, 255, 255, 0.66);
  }

  .featured-dish__desc {
    margin-top: var(--space-2);
    color: rgba(255, 255, 255, 0.72);
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  .featured-dish__tags {
    min-height: 25px;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin-top: var(--space-3);
  }

  .featured .dietary-tag {
    padding: 2px var(--space-2);
    border-radius: var(--radius-full);
    background: rgba(232, 245, 233, 0.14);
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #d8f0d9;
    border: 1px solid rgba(216, 240, 217, 0.28);
  }

  .featured__cta {
    grid-area: cta;
  }

  .featured__cta .btn {
    box-shadow: 0 10px 28px rgba(11, 38, 15, 0.24);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (min-width: 700px) and (max-width: 1023px) {
    .featured__intro {
      max-width: 580px;
    }

    .featured .section-title {
      max-width: none;
    }

    .featured-selector__list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      margin-inline: 0;
      padding-inline: 0;
      overflow: visible;
    }

    .featured-selector__item {
      width: 100%;
      justify-content: start;
    }
  }

  @media (min-width: 1024px) {
    .featured__shell {
      grid-template-columns: minmax(270px, 0.72fr) minmax(0, 1.28fr);
      grid-template-areas:
        'intro stage'
        'selector stage'
        'cta stage';
      column-gap: clamp(3rem, 7vw, 7rem);
      row-gap: var(--space-5);
      align-items: start;
    }

    .featured-selector__list {
      display: grid;
      gap: 0;
      margin: 0;
      padding: 0;
      overflow: visible;
      scroll-snap-type: none;
      border-top: 1px solid rgba(255, 255, 255, 0.16);
    }

    .featured-selector__item {
      width: 100%;
      grid-template-columns: 2.5rem minmax(0, 1fr) auto;
      min-height: 58px;
      padding: var(--space-2) 0;
      border: 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.16);
      border-radius: 0;
      text-align: left;
    }

    .featured-selector__item:hover,
    .featured-selector__item.is-active {
      border-color: rgba(255, 255, 255, 0.16);
      background: transparent;
    }

    .featured-selector__item:hover .featured-selector__name,
    .featured-selector__item.is-active .featured-selector__name {
      transform: translateX(5px);
    }

    .featured-selector__name {
      white-space: normal;
      transition: transform var(--duration-fast) var(--ease-out);
    }

    .featured-selector__marker {
      display: block;
      width: 0;
      height: 2px;
      background: var(--color-accent-light);
      transition: width var(--duration-normal) var(--ease-out);
    }

    .featured-selector__item.is-active .featured-selector__marker {
      width: 28px;
    }

    .featured-stage {
      align-self: stretch;
      min-height: 720px;
    }

    .featured-dish {
      grid-template-rows: minmax(430px, 1fr) auto;
      padding: var(--space-4);
    }

    .featured-dish__details {
      min-height: 180px;
    }
  }

  @media (max-width: 420px) {
    .featured-stage {
      min-height: 550px;
      margin-inline: calc(var(--gutter) * -0.45);
    }

    .featured-dish {
      grid-template-rows: minmax(285px, 1fr) auto;
      padding: var(--space-2);
    }

    .featured-dish__details {
      min-height: 220px;
      padding: var(--space-3);
    }

    .featured-dish__name {
      font-size: var(--text-xl);
    }

    .featured-dish__heading {
      align-items: start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .featured-dish,
    .featured-dish__image,
    .featured-selector__item,
    .featured-selector__name,
    .featured-selector__marker {
      transition: none;
      animation: none !important;
    }

    .featured-autoplay {
      display: none;
    }
  }

  /* Minimal editorial rail overrides */
  .featured {
    isolation: auto;
    overflow: hidden;
    background: #f6f2e9;
    color: var(--color-text);
    border-top: 1px solid rgba(44, 36, 22, 0.08);
  }

  .featured::before {
    content: none;
  }

  .featured__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .featured__intro {
    grid-area: auto;
    max-width: 560px;
  }

  .featured .section-label {
    color: var(--color-accent-warm);
  }

  .featured .section-title {
    max-width: none;
    margin-bottom: var(--space-2);
    color: var(--color-text);
  }

  .featured__subtitle {
    max-width: 38ch;
    color: var(--color-text-muted);
    font-size: var(--text-base);
    line-height: 1.6;
  }

  .featured-rail:focus-visible {
    outline: 3px solid var(--color-accent-light);
    outline-offset: 3px;
  }

  .featured-rail {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 84vw;
    gap: var(--space-3);
    margin-top: var(--space-5);
    margin-inline: calc(var(--gutter) * -1);
    padding: 3.75rem var(--gutter) var(--space-4);
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-inline: contain;
    scroll-behavior: smooth;
    scroll-padding-inline: var(--gutter);
    scroll-snap-type: inline mandatory;
    scrollbar-width: thin;
    scrollbar-color: rgba(53, 122, 56, 0.4) transparent;
  }

  .featured-rail.is-autoplaying {
    scroll-behavior: auto;
    scroll-snap-type: none;
  }

  .featured-rail::-webkit-scrollbar {
    height: 5px;
  }

  .featured-rail::-webkit-scrollbar-thumb {
    border-radius: var(--radius-full);
    background: rgba(53, 122, 56, 0.4);
  }

  .featured-rail__item {
    min-width: 0;
    display: flex;
    scroll-snap-align: start;
  }

  .featured-card {
    position: relative;
    width: 100%;
    min-height: 515px;
    display: grid;
    grid-template-rows: 220px 1fr;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-lg);
    background: #2d6733;
    color: var(--color-text-inverse);
    box-shadow: 0 2px 8px rgba(44, 36, 22, 0.06);
    transition:
      background-color var(--duration-normal),
      transform var(--duration-normal) var(--ease-out);
  }

  .featured-card:hover {
    background: #275d2d;
    transform: translateY(-3px);
  }

  .featured-card__number {
    position: absolute;
    z-index: 0;
    top: -0.08em;
    right: 0.06em;
    color: rgba(255, 255, 255, 0.075);
    font-family: var(--font-heading);
    font-size: clamp(7rem, 9vw, 9.5rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.08em;
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.06), 0 12px 28px rgba(9, 38, 14, 0.14);
    pointer-events: none;
    user-select: none;
  }

  .featured-card__visual {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    height: 270px;
    margin-top: -3.5rem;
    pointer-events: none;
  }

  .featured-card__image {
    width: min(112%, 350px);
    height: auto;
    aspect-ratio: 1;
    object-fit: contain;
    filter: drop-shadow(0 17px 18px rgba(9, 38, 14, 0.24));
    mask-image: radial-gradient(circle at 50% 48%, #000 48%, rgba(0, 0, 0, 0.96) 59%, transparent 72%);
    transition: transform var(--duration-normal) var(--ease-out);
  }

  .featured-card__image--derek-tibs {
    width: min(136%, 425px);
  }

  .featured-card__image--teff-cake {
    width: min(154%, 475px);
  }

  .featured-card:hover .featured-card__image {
    transform: translateY(-5px) scale(1.015);
  }

  .featured-card__placeholder {
    width: 210px;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 50%;
    color: rgba(255, 255, 255, 0.75);
  }

  .featured-card__body {
    min-height: 0;
    display: flex;
    flex-direction: column;
    padding: var(--space-4);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .featured-card__amharic {
    min-height: 1.5em;
    margin-bottom: var(--space-1);
    color: rgba(255, 255, 255, 0.62);
    font-size: var(--text-xs);
  }

  .featured-card__heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .featured-card__name {
    color: var(--color-text-inverse);
    font-size: var(--text-xl);
    line-height: 1.2;
  }

  .featured-card__price {
    flex: 0 0 auto;
    color: var(--color-accent-light);
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 700;
  }

  .featured-card__price span {
    color: rgba(255, 255, 255, 0.56);
    font-size: 0.65em;
    font-weight: 500;
  }

  .featured-card__desc {
    margin-top: var(--space-2);
    color: rgba(255, 255, 255, 0.72);
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  .featured-card__tags {
    min-height: 25px;
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: var(--space-1);
    margin-top: auto;
    padding-top: var(--space-3);
  }

  .featured-card .dietary-tag {
    padding: 2px var(--space-2);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-full);
    color: rgba(255, 255, 255, 0.76);
    font-family: var(--font-heading);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .featured__footer {
    display: flex;
    justify-content: center;
    margin-top: var(--space-5);
  }

  .featured__footer-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding-block: var(--space-2);
    color: var(--color-primary-dark);
    font-family: var(--font-heading);
    font-size: var(--text-base);
    font-weight: 600;
  }

  .featured__footer-link span {
    padding-bottom: 2px;
    border-bottom: 1px solid currentColor;
  }

  .featured__footer-link svg {
    width: 20px;
    height: 20px;
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .featured__footer-link path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .featured__footer-link:hover svg {
    transform: translateX(4px);
  }

  .featured__footer-link:focus-visible {
    outline: 3px solid var(--color-accent-light);
    outline-offset: 3px;
  }

  @media (min-width: 640px) {
    .featured__header {
      flex-direction: row;
      align-items: end;
      justify-content: space-between;
    }

    .featured-rail {
      grid-auto-columns: calc((100% - var(--space-3)) / 2.18);
      margin-inline: 0;
      padding-inline: 0;
      scroll-padding-inline: 0;
    }
  }

  @media (min-width: 1024px) {
    .featured-rail {
      grid-auto-columns: calc((100% - (var(--space-3) * 2)) / 3.18);
      gap: var(--space-3);
      margin-top: var(--space-6);
    }

    .featured-card {
      min-height: 535px;
      grid-template-rows: 230px 1fr;
    }

    .featured-card__visual {
      height: 285px;
    }

    .featured__footer {
      margin-top: var(--space-6);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .featured-rail {
      scroll-behavior: auto;
    }

    .featured-card,
    .featured-card__image,
    .featured__footer-link svg {
      transition: none;
    }
  }

  /* ========== ATMOSPHERE ========== */
  .atmosphere {
    background-color: var(--color-surface-alt);
    position: relative;
  }

  .atmosphere-carousel {
    position: relative;
    height: clamp(22rem, 112vw, 33rem);
    margin-top: var(--space-6);
    overflow: hidden;
    touch-action: pan-y;
  }

  .atmosphere-carousel__track {
    position: absolute;
    inset: 0;
  }

  @media (min-width: 900px) {
    .atmosphere-carousel {
      height: clamp(25rem, 44vw, 33rem);
    }
  }

  .atmosphere-card {
    --carousel-position: 0;
    --carousel-distance: 0;
    --carousel-step: min(48vw, 14rem);
    position: absolute;
    top: 50%;
    left: 50%;
    display: block;
    width: clamp(9.5rem, 56vw, 18rem);
    min-width: 0;
    border-radius: var(--radius-lg);
    border: 2px solid var(--color-primary);
    overflow: hidden;
    aspect-ratio: 9 / 16;
    background-color: var(--color-primary-dark);
    box-shadow: var(--shadow-md);
    text-align: left;
    isolation: isolate;
    opacity: max(0.35, calc(0.88 - (var(--carousel-distance) * 0.15)));
    z-index: calc(10 - var(--carousel-distance));
    transform:
      translate(-50%, -50%)
      translateX(calc(var(--carousel-position) * var(--carousel-step)))
      scale(0.9);
    transition:
      transform 650ms var(--ease-in-out),
      box-shadow 400ms var(--ease-out),
      opacity 650ms var(--ease-in-out);
  }

  .atmosphere-card[data-carousel-distance='2'],
  .atmosphere-card[data-carousel-distance='3'] {
    opacity: 0;
    pointer-events: none;
  }

  @media (min-width: 900px) {
    .atmosphere-card {
      --carousel-step: clamp(9.75rem, 17.5vw, 13.5rem);
      width: clamp(13rem, 21vw, 16.5rem);
    }

    .atmosphere-card[data-carousel-distance='2'] {
      opacity: calc(0.88 - (var(--carousel-distance) * 0.15));
      pointer-events: auto;
    }
  }

  .atmosphere-card.is-active {
    box-shadow:
      0 0 0 3px var(--color-primary-light),
      var(--shadow-xl);
    opacity: 1;
    z-index: 20;
    transform:
      translate(-50%, -50%)
      translateX(calc(var(--carousel-position) * var(--carousel-step)))
      scale(1.1);
  }

  .atmosphere-card.is-wrapping {
    transition: none;
  }

  .atmosphere-card:not(.is-active):hover {
    box-shadow: var(--shadow-lg);
  }

  .atmosphere-card:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 3px;
  }

  .atmosphere-card__media {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .atmosphere-card__poster,
  .atmosphere-card__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity var(--duration-normal) var(--ease-out);
  }

  .atmosphere-card__poster {
    z-index: 1;
  }

  .atmosphere-card__video {
    z-index: 2;
    opacity: 0;
  }

  .atmosphere-card.is-playing .atmosphere-card__video {
    opacity: 1;
  }

  .atmosphere-card__overlay {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: var(--space-4);
    background: linear-gradient(
      to top,
      rgba(15, 45, 18, 0.92) 0%,
      rgba(15, 45, 18, 0.38) 45%,
      transparent 75%
    );
    color: var(--color-text-inverse);
    pointer-events: none;
  }

  .atmosphere-card__amharic {
    font-size: var(--text-xs);
    color: var(--color-accent-light);
    margin-bottom: 2px;
    letter-spacing: 0.05em;
  }

  .atmosphere-card__title {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-text-inverse);
    line-height: 1.25;
  }

  .atmosphere-card:not(.is-active) .atmosphere-card__overlay {
    padding: var(--space-3);
  }

  .atmosphere-card:not(.is-active) .atmosphere-card__amharic {
    display: none;
  }

  .atmosphere-card:not(.is-active) .atmosphere-card__title {
    font-size: var(--text-sm);
  }

  @media (max-width: 399px) {
    .atmosphere-card {
      border-radius: var(--radius-md);
    }

    .atmosphere-card__overlay,
    .atmosphere-card:not(.is-active) .atmosphere-card__overlay {
      padding: var(--space-2);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .atmosphere-card,
    .atmosphere-card__poster,
    .atmosphere-card__video {
      transition: none;
    }
  }

  /* ========== REVIEWS ========== */
  .reviews {
    background-color: var(--color-surface);
  }

  .reviews-rating {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  .reviews-stars {
    display: flex;
    gap: 2px;
  }

  .reviews-avg {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--color-text);
  }

  .reviews-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  @media (min-width: 768px) {
    .reviews-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .reviews-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .review-card {
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .review-card__stars {
    display: flex;
    gap: 2px;
  }

  .review-card__text {
    flex: 1;
  }

  .review-card__text p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.6;
    font-style: italic;
  }

  .review-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-2);
    border-top: 1px solid var(--color-border-light);
