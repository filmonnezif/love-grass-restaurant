---
/* Footer with contact info, hours, map, and business schema */
---

<footer class="site-footer" id="contact">
  <div class="footer-top">
    <div class="container">
      <div class="footer-grid">
        <!-- Brand & About -->
        <div class="footer-col">
          <div class="footer-brand">
            <img
              src="/images/logo.webp"
              alt="Love Grass Restaurant"
              width="56"
              height="56"
              loading="lazy"
              class="footer-logo"
            />
            <h3 class="footer-name">Love Grass Restaurant</h3>
            <p class="font-ethiopic footer-amharic">እንጀራ መጋገሪያ ቤት</p>
          </div>
          <p class="footer-tagline">
            The place where you can get home made Ethiopian Foods and Injera
          </p>
        </div>

        <!-- Quick Links -->
        <div class="footer-col">
          <h4 class="footer-heading">Quick Links</h4>
          <ul class="footer-links" role="list">
            <li><a href="/">Home</a></li>
            <li><a href="/menu">Our Menu</a></li>
            <li><a href="/about">About Us</a></li>
            <li><a href="/about#faq">FAQ</a></li>
          </ul>
        </div>

        <!-- Contact Info -->
        <div class="footer-col">
          <h4 class="footer-heading">Contact Us</h4>
          <address class="footer-contact">
            <p>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              <span>Dubai, United Arab Emirates</span>
            </p>
            <p>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"></path>
              </svg>
              <a href="tel:+971000000000">+971 00 000 0000</a>
            </p>
            <p>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
              <a href="mailto:info@love-grass.com">info@love-grass.com</a>
            </p>
          </address>
        </div>

        <!-- Opening Hours -->
        <div class="footer-col">
          <h4 class="footer-heading">Opening Hours</h4>
          <dl class="footer-hours">
            <div>
              <dt>Monday – Thursday</dt>
              <dd>11:00 AM – 11:00 PM</dd>
            </div>
            <div>
              <dt>Friday – Saturday</dt>
              <dd>11:00 AM – 12:00 AM</dd>
            </div>
            <div>
              <dt>Sunday</dt>
              <dd>12:00 PM – 11:00 PM</dd>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </div>

  <!-- Map -->
  <div class="footer-map">
    <iframe
      src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3608.123456!2d55.2708!3d25.2048!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMjXCsDEyJzE3LjMiTiA1NcKwMTYnMTQuOSJF!5e0!3m2!1sen!2sae!4v0"
      width="100%"
      height="300"
      style="border:0;"
      allowfullscreen=""
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      title="Love Grass Restaurant location on Google Maps"
    ></iframe>
  </div>

  <!-- Bottom Bar -->
  <div class="footer-bottom">
    <div class="container">
      <p>&copy; {new Date().getFullYear()} Love Grass Restaurant LLC. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-primary-dark);
    color: var(--color-text-inverse);
    margin-top: auto;
  }

  .footer-top {
    padding-block: var(--space-7);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1.5fr 1fr 1fr 1fr;
    }
  }

  /* Brand */
  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-bottom: var(--space-3);
  }

  .footer-logo {
    width: 56px;
    height: 56px;
    border-radius: var(--radius-full);
  }

  .footer-name {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-text-inverse);
  }

  .footer-amharic {
    font-size: var(--text-sm);
    opacity: 0.8;
  }

  .footer-tagline {
    font-size: var(--text-sm);
    opacity: 0.75;
    line-height: 1.5;
    max-width: 30ch;
  }

  /* Headings */
  .footer-heading {
    font-family: var(--font-heading);
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-accent-light);
    margin-bottom: var(--space-3);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Links */
  .footer-links li + li {
    margin-top: var(--space-2);
  }

  .footer-links a {
    font-size: var(--text-sm);
    opacity: 0.8;
    transition: opacity var(--duration-fast) var(--ease-out);
  }

  .footer-links a:hover {
    opacity: 1;
    color: var(--color-accent-light);
  }

  /* Contact */
  .footer-contact {
    font-style: normal;
  }

  .footer-contact p {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    opacity: 0.8;
  }

  .footer-contact p + p {
    margin-top: var(--space-2);
  }

  .footer-contact a:hover {
    color: var(--color-accent-light);
  }

  .footer-contact svg {
    flex-shrink: 0;
    opacity: 0.6;
  }

  /* Hours */
  .footer-hours div {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    font-size: var(--text-sm);
    padding-block: var(--space-1);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .footer-hours dt {
    opacity: 0.7;
  }

  .footer-hours dd {
    font-weight: 500;
    white-space: nowrap;
  }

  /* Map */
  .footer-map {
    width: 100%;
    line-height: 0;
  }

  .footer-map iframe {
    width: 100%;
    filter: grayscale(0.3) contrast(1.1);
  }

  /* Bottom */
  .footer-bottom {
    padding-block: var(--space-3);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    text-align: center;
    font-size: var(--text-xs);
    opacity: 0.6;
  }
</style>
