---
import BaseLayout from '../layouts/BaseLayout.astro';
import menuData from '../data/menu.json';
import reviewsData from '../data/reviews.json';

/* Compute aggregate rating for schema */
const allRatings = reviewsData.map(r => r.rating);
const avgRating = (allRatings.reduce((a, b) => a + b, 0) / allRatings.length).toFixed(1);

const aggregateRatingSchema = {
  "@context": "https://schema.org",
  "@type": "Restaurant",
  "name": "Love Grass Restaurant",
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": avgRating,
    "bestRating": "5",
    "worstRating": "1",
    "ratingCount": String(allRatings.length)
  }
};

/* Featured items (tagged as 'popular' or 'signature') */
const featuredItems = menuData.sections
  .flatMap(s => s.items)
  .filter(item => item.tags.includes('popular') || item.tags.includes('signature'))
  .slice(0, 6);

/* Star SVG helper */
const starSVG = `<svg width="16" height="16" viewBox="0 0 24 24" fill="var(--color-star)" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>`;
---

<BaseLayout
  title="Love Grass Restaurant"
  description="Authentic Ethiopian restaurant in Dubai serving homemade teff injera, Tibs, Kitfo, Doro Wot, and traditional dishes. Experience the flavors of Ethiopia."
  schema={aggregateRatingSchema}
>

  <!-- ========== HERO SECTION ========== -->
  <section class="hero" id="hero" aria-label="Welcome to Love Grass Restaurant">
    <div class="hero__bg">
      <!-- Lottie animation will be loaded as an island here -->
      <div class="hero__lottie" id="hero-lottie-container" aria-hidden="true"></div>
      <div class="hero__overlay"></div>
    </div>
    <div class="hero__content container">
      <p class="hero__label font-accent hero-animate">Welcome to</p>
      <h1 class="hero__title hero-animate hero-animate--delay-1">
        Love Grass<br />
        <span class="text-accent font-accent">Restaurant</span>
      </h1>
      <p class="hero__subtitle hero-animate hero-animate--delay-2">
        The place where you can get home made Ethiopian Foods and Injera
      </p>
      <div class="hero__actions hero-animate hero-animate--delay-3">
        <a href="/menu" class="btn btn--accent btn--lg pulse">
          Explore Our Menu
        </a>
        <a href="#featured" class="btn btn--outline btn--lg">
          Our Specials
        </a>
      </div>
    </div>
  </section>

  <!-- ========== FEATURED PRODUCTS ========== -->
  <section class="section featured" id="featured" aria-labelledby="featured-title">
    <div class="container">
      <div class="text-center" data-reveal>
        <p class="section-label">Our Specialties</p>
        <h2 class="section-title" id="featured-title">Signature Dishes</h2>
        <hr class="divider" style="margin-inline: auto;" />
        <p class="section-subtitle" style="margin-inline: auto;">
          Handcrafted with love using traditional recipes and the finest teff flour
        </p>
      </div>

      <div class="featured-grid">
        {featuredItems.map((item, i) => (
          <article class="featured-card card" data-reveal data-reveal-delay={String(Math.min(i + 1, 5))}>
            <div class="featured-card__img img-zoom">
              <div class="featured-card__placeholder" aria-label={item.name}>
                <span class="font-ethiopic">{item.nameAmharic}</span>
              </div>
            </div>
            <div class="featured-card__body">
              <h3 class="featured-card__name">
                {item.name}
                <span class="font-ethiopic featured-card__amharic">{item.nameAmharic}</span>
              </h3>
              <p class="featured-card__desc">{item.description}</p>
              <div class="featured-card__footer">
                <span class="price">
                  <span class="price-currency">AED</span> {item.price}
                </span>
                {item.dietary.length > 0 && (
                  <div class="featured-card__tags">
                    {item.dietary.map(tag => (
                      <span class="dietary-tag">{tag}</span>
                    ))}
                  </div>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>

      <div class="text-center mt-6" data-reveal>
        <a href="/menu" class="btn btn--primary btn--lg">
          View Full Menu
        </a>
      </div>
    </div>
  </section>

  <!-- ========== ATMOSPHERE ========== -->
  <section class="section atmosphere" id="atmosphere" aria-labelledby="atmosphere-title">
    <div class="container">
      <div class="text-center" data-reveal>
        <p class="section-label">The Experience</p>
        <h2 class="section-title" id="atmosphere-title">Our Atmosphere</h2>
        <hr class="divider" style="margin-inline: auto;" />
        <p class="section-subtitle" style="margin-inline: auto;">
          A warm, welcoming space where every meal feels like a gathering with family
        </p>
      </div>

      <div class="atmosphere-grid" data-reveal>
        <div class="atmosphere-item atmosphere-item--large img-zoom">
          <div class="atmosphere-placeholder">
            <span>Restaurant Interior</span>
          </div>
        </div>
        <div class="atmosphere-item img-zoom">
          <div class="atmosphere-placeholder">
            <span>Ethiopian Coffee Ceremony</span>
          </div>
        </div>
        <div class="atmosphere-item img-zoom">
          <div class="atmosphere-placeholder">
            <span>Communal Dining</span>
          </div>
        </div>
        <div class="atmosphere-item img-zoom">
          <div class="atmosphere-placeholder">
            <span>Celebrity Guests</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== GOOGLE REVIEWS ========== -->
  <section class="section reviews" id="reviews" aria-labelledby="reviews-title">
    <div class="container">
      <div class="text-center" data-reveal>
        <p class="section-label">What People Say</p>
        <h2 class="section-title" id="reviews-title">Our Reviews</h2>
        <hr class="divider" style="margin-inline: auto;" />
        <div class="reviews-rating">
          <div class="reviews-stars" aria-label={`Rated ${avgRating} out of 5 stars`}>
            {Array.from({ length: 5 }).map(() => (
              <Fragment set:html={starSVG} />
            ))}
          </div>
          <span class="reviews-avg">{avgRating}</span>
          <span class="text-muted text-sm">based on {reviewsData.length} reviews</span>
        </div>
      </div>

      <div class="reviews-grid">
        {reviewsData.map((review, i) => (
          <article class="review-card card" data-reveal data-reveal-delay={String(Math.min(i + 1, 5))}>
            <div class="review-card__stars" aria-label={`${review.rating} stars`}>
              {Array.from({ length: review.rating }).map(() => (
                <Fragment set:html={starSVG} />
              ))}
            </div>
            <blockquote class="review-card__text">
              <p>"{review.text}"</p>
            </blockquote>
            <footer class="review-card__footer">
              <cite class="review-card__author">{review.author}</cite>
              <span class="review-card__source">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"></path>
                  <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"></path>
                  <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"></path>
                  <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"></path>
                </svg>
                {review.source}
              </span>
            </footer>
          </article>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ========== HERO ========== */
  .hero {
    position: relative;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background-color: var(--color-primary-dark);
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__lottie {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      rgba(27, 77, 28, 0.85) 0%,
      rgba(45, 106, 46, 0.7) 40%,
      rgba(45, 106, 46, 0.5) 100%
    );
  }

  .hero__content {
    position: relative;
    z-index: 1;
    padding-block: var(--space-8);
    color: var(--color-text-inverse);
  }

  .hero__label {
    font-size: var(--text-xl);
    color: var(--color-accent-light);
    margin-bottom: var(--space-2);
  }

  .hero__title {
    font-size: var(--text-5xl);
    font-weight: 700;
    color: var(--color-text-inverse);
    line-height: 1.1;
    margin-bottom: var(--space-4);
  }

  .hero__title .text-accent {
    color: var(--color-accent-light);
  }

  .hero__subtitle {
    font-size: var(--text-lg);
    opacity: 0.9;
    max-width: 50ch;
    margin-bottom: var(--space-5);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .hero__actions .btn--outline {
    border-color: var(--color-text-inverse);
    color: var(--color-text-inverse);
  }

  .hero__actions .btn--outline:hover {
    background-color: var(--color-text-inverse);
    color: var(--color-primary-dark);
  }

  /* ========== FEATURED PRODUCTS ========== */
  .featured {
    background-color: var(--color-surface);
  }

  .featured-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  @media (min-width: 480px) {
    .featured-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .featured-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .featured-card__img {
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .featured-card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--color-primary-50), var(--color-primary-100));
    color: var(--color-primary);
    font-family: var(--font-ethiopic);
    font-size: var(--text-2xl);
    font-weight: 600;
  }

  .featured-card__body {
    padding: var(--space-3);
  }

  .featured-card__name {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 600;
    margin-bottom: var(--space-1);
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .featured-card__amharic {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    font-weight: 400;
  }

  .featured-card__desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
    line-height: 1.5;
  }

  .featured-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .featured-card__tags {
    display: flex;
    gap: var(--space-1);
  }

  .dietary-tag {
    font-size: var(--text-xs);
    font-family: var(--font-heading);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 2px var(--space-2);
    border-radius: var(--radius-full);
    background-color: var(--color-primary-50);
    color: var(--color-primary);
  }

  /* ========== ATMOSPHERE ========== */
  .atmosphere {
    background-color: var(--color-surface-alt);
  }

  .atmosphere-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  @media (min-width: 768px) {
    .atmosphere-grid {
      grid-template-columns: repeat(2, 1fr);
      grid-template-rows: auto auto;
    }

    .atmosphere-item--large {
      grid-row: 1 / 3;
    }
  }

  .atmosphere-item {
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .atmosphere-placeholder {
    aspect-ratio: 16 / 10;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--color-primary-dark), var(--color-primary));
    color: var(--color-text-inverse);
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: var(--text-sm);
    opacity: 0.7;
  }

  .atmosphere-item--large .atmosphere-placeholder {
    aspect-ratio: auto;
    height: 100%;
    min-height: 300px;
  }

  /* ========== REVIEWS ========== */
  .reviews {
    background-color: var(--color-surface);
  }

  .reviews-rating {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  .reviews-stars {
    display: flex;
    gap: 2px;
  }

  .reviews-avg {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--color-text);
  }

  .reviews-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  @media (min-width: 768px) {
    .reviews-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .reviews-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .review-card {
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .review-card__stars {
    display: flex;
    gap: 2px;
  }

  .review-card__text {
    flex: 1;
  }

  .review-card__text p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.6;
    font-style: italic;
  }

  .review-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-2);
    border-top: 1px solid var(--color-border-light);
  }

  .review-card__author {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: var(--text-sm);
    font-style: normal;
  }

  .review-card__source {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
</style>

<!-- Lottie Animation Loader (Island — loads only after page is idle) -->
<script>
  async function initLottie() {
    try {
      const container = document.getElementById('hero-lottie-container');
      if (!container) return;

      /* Respect reduced motion */
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      const { DotLottie } = await import('@lottiefiles/dotlottie-web');

      const canvas = document.createElement('canvas');
      canvas.style.width = '100%';
      canvas.style.height = '100%';
      canvas.setAttribute('aria-hidden', 'true');
      container.appendChild(canvas);

      new DotLottie({
        canvas,
        src: '/lottie/hero-animation.lottie',
        autoplay: true,
        loop: true,
      });
    } catch (e) {
      /* Graceful fallback — hero still works without animation */
      console.warn('Lottie failed to load:', e);
    }
  }

  /* Load after page is idle */
  if ('requestIdleCallback' in window) {
    requestIdleCallback(() => initLottie());
  } else {
    setTimeout(initLottie, 200);
  }
</script>
