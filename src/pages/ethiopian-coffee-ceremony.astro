---
import BaseLayout from '../layouts/BaseLayout.astro';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://love-grass.com/" },
    { "@type": "ListItem", "position": 2, "name": "About Us", "item": "https://love-grass.com/about" },
    { "@type": "ListItem", "position": 3, "name": "The Ethiopian Coffee Ceremony", "item": "https://love-grass.com/ethiopian-coffee-ceremony" }
  ]
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "The Ethiopian Coffee Ceremony (Buna): A Ritual of Connection",
  "description": "Discover Ethiopia's ancient coffee ritual (Buna) — from washing green beans and roasting over charcoal to three sacred rounds (Abol, Tona, Baraka).",
  "author": {
    "@type": "Organization",
    "name": "Love Grass Restaurant"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Love Grass Restaurant",
    "logo": {
      "@type": "ImageObject",
      "url": "https://love-grass.com/images/logo.webp"
    }
  }
};

const coffeeSteps = [
  {
    step: "01",
    title: "Green Coffee Beans Washing",
    amharic: "ቡና ማጠብ",
    desc: "The fresh green coffee beans are washed and cleaned carefully before roasting to eliminate any impurities or dust."
  },
  {
    step: "02",
    title: "Coffee Roasting",
    amharic: "ቡና መቆላት",
    desc: "The beans are put in a traditional pan and roasted over open charcoal until dark brown and deeply aromatic. The host passes around the smoking pan so guests can inhale the rich aroma."
  },
  {
    step: "03",
    title: "Grinding the Beans",
    amharic: "ቡና መውቀጥ",
    desc: "The roasted beans are ground by hand in a traditional wooden mortar (mukecha) and pestle (zenezena), producing fresh, coarsely ground coffee."
  },
  {
    step: "04",
    title: "Brewing the Buna (Jebena)",
    amharic: "ቡና ማፍላት",
    desc: "The ground coffee is placed in a traditional spoutless clay coffee pot known as a jebena, mixed with fresh water, and slowly brought to a boil over charcoal."
  },
  {
    step: "05",
    title: "First Round – Abol (አቦል)",
    amharic: "አቦል",
    desc: "Abol is the first and strongest round of coffee. Poured gently from high above into small handleless ceramic cups (sini), it is enjoyed alongside conversation and popcorn or roasted grains."
  },
  {
    step: "06",
    title: "Second Round – Tona (ቶና)",
    amharic: "ቶና",
    desc: "The remaining coffee grounds in the jebena are mixed with fresh water and re-brewed for a second round. Tona is lighter than Abol, continuing the rhythm of conversation."
  },
  {
    step: "07",
    title: "Third Round – Baraka (በረካ)",
    amharic: "በረካ",
    desc: "The coffee is brewed for a third and final round, known as Baraka ('blessing'). This final cup symbolizes goodwill, peace, and spiritual blessing for all participants."
  },
  {
    step: "08",
    title: "Connect and Share",
    amharic: "መገናኘት እና መጋራት",
    desc: "The ceremony is not simply about drinking coffee — it is a ritual of hospitality, community, friendship, and connection. Guests gather, share stories, and slow down together."
  }
];
---

<BaseLayout
  title="The Ethiopian Coffee Ceremony | Love Grass Restaurant"
  description="Learn about Ethiopia's coffee ceremony (Buna) — a traditional ritual of hospitality, community, and connection featuring three rounds of fresh coffee."
  schema={[articleSchema, breadcrumbSchema]}
>

  <!-- ========== HERO HEADER ========== -->
  <section class="coffee-hero" aria-label="The Ethiopian Coffee Ceremony">
    <div class="coffee-hero__overlay"></div>
    <div class="coffee-hero__content container text-center">
      <a href="/about" class="back-btn hero-animate" aria-label="Back to About Us" style="margin-inline: auto;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
        <span>Back to About Us</span>
      </a>
      <p class="section-label hero-animate" style="color: var(--color-accent-light);">Ritual & Heritage</p>
      <h1 class="coffee-hero__title hero-animate hero-animate--delay-1">The Ethiopian Coffee Ceremony</h1>
      <p class="coffee-hero__subtitle hero-animate hero-animate--delay-2">
        Buna — A Traditional Ritual Steeped in Hospitality, Community & Connection
      </p>
    </div>
  </section>

  <!-- ========== INTRO & QUOTE ========== -->
  <section class="section intro-section">
    <div class="container container--narrow text-center">
      <div data-reveal>
        <p class="section-label">The Spirit of Buna</p>
        <h2 class="section-title">More Than Just a Drink</h2>
        <hr class="divider" style="margin-inline: auto;" />
      </div>

      <blockquote class="quote-box" data-reveal>
        <p class="quote-text">
          “Three rounds of buna, one common tradition and a beautiful expression of Ethiopian hospitality.”
        </p>
      </blockquote>
    </div>
  </section>

  <!-- ========== STEPS GRID ========== -->
  <section class="section steps-section">
    <div class="container">
      <div class="steps-grid">
        {coffeeSteps.map((item, index) => (
          <div class="step-card card" data-reveal data-reveal-delay={String(Math.min(index + 1, 5))}>
            <div class="step-card__header">
              <span class="step-badge">Step {item.step}</span>
              <p lang="am" class="step-card__amharic">{item.amharic}</p>
            </div>
            <div class="step-card__body">
              <h3 class="step-card__title">{item.title}</h3>
              <p class="step-card__desc">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========== CTA ========== -->
  <section class="section cta-section" aria-label="Experience Ethiopian hospitality">
    <div class="container text-center" data-reveal>
      <h2 class="cta-section__title">Experience Ethiopian Hospitality</h2>
      <p class="cta-section__subtitle">
        Join us at Love Grass Restaurant in Abu Hail, Dubai for authentic Ethiopian cuisine and coffee.
      </p>
      <a href="/menu" class="btn btn--accent btn--lg pulse">
        Explore Our Menu
      </a>
    </div>
  </section>

</BaseLayout>

<style>
  /* ========== HERO ========== */
  .coffee-hero {
    position: relative;
    padding-block: calc(var(--header-height) + var(--space-6)) var(--space-6);
    background: linear-gradient(135deg, var(--color-primary-dark), var(--color-primary));
    color: var(--color-text-inverse);
  }

  .coffee-hero__overlay {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 30% 40%, rgba(212, 148, 58, 0.15), transparent 50%),
      radial-gradient(circle at 80% 70%, rgba(255, 255, 255, 0.05), transparent 40%);
  }

  .coffee-hero__content {
    position: relative;
    z-index: 1;
  }

  .coffee-hero__title {
    font-size: var(--text-5xl);
    color: var(--color-text-inverse);
    margin-bottom: var(--space-3);
  }

  .coffee-hero__subtitle {
    font-size: var(--text-lg);
    opacity: 0.9;
    max-width: 55ch;
    margin-inline: auto;
  }

  /* ========== QUOTE BOX ========== */
  .quote-box {
    margin-top: var(--space-4);
    padding: var(--space-4) var(--space-5);
    background-color: var(--color-primary-50);
    border-left: 4px solid var(--color-primary);
    border-radius: var(--radius-md);
  }

  .quote-text {
    font-family: var(--font-accent);
    font-size: var(--text-xl);
    font-style: italic;
    color: var(--color-primary-dark);
    line-height: 1.6;
  }

  /* ========== STEPS GRID ========== */
  .steps-section {
    background-color: var(--color-surface-alt);
  }

  .steps-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  @media (min-width: 768px) {
    .steps-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-5);
    }
  }

  @media (min-width: 1024px) {
    .steps-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .step-card {
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    background-color: var(--color-surface-card);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-lg);
    transition: transform var(--duration-normal) var(--ease-out), box-shadow var(--duration-normal) var(--ease-out);
  }

  .step-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .step-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .step-badge {
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-primary);
    background-color: var(--color-primary-50);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-full);
  }

  .step-card__amharic {
    font-size: var(--text-xs);
    color: var(--color-primary-dark);
    font-weight: 600;
  }

  .step-card__title {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--space-1);
  }

  .step-card__desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  /* ========== CTA ========== */
  .cta-section {
    background: linear-gradient(135deg, var(--color-primary-dark), var(--color-primary));
    color: var(--color-text-inverse);
  }

  .cta-section__title {
    font-size: var(--text-4xl);
    color: var(--color-text-inverse);
    margin-bottom: var(--space-3);
  }

  .cta-section__subtitle {
    font-size: var(--text-lg);
    opacity: 0.9;
    max-width: 50ch;
    margin-inline: auto;
    margin-bottom: var(--space-5);
  }
</style>
