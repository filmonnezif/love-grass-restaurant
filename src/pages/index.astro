---
import BaseLayout from '../layouts/BaseLayout.astro';
import menuData from '../data/menu.json';
import reviewsData from '../data/reviews.json';

/* Compute aggregate rating for schema */
const allRatings = reviewsData.map(r => r.rating);
const avgRating = (allRatings.reduce((a, b) => a + b, 0) / allRatings.length).toFixed(1);

const aggregateRatingSchema = {
  "@context": "https://schema.org",
  "@type": "Restaurant",
  "name": "Love Grass Restaurant",
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": avgRating,
    "bestRating": "5",
    "worstRating": "1",
    "ratingCount": String(allRatings.length)
  }
};

/* Featured items (tagged as 'popular' or 'signature') */
const featuredItems = menuData.sections
  .flatMap(s => s.items)
  .filter(item => item.tags.includes('popular') || item.tags.includes('signature'))
  .slice(0, 6);

/* Star SVG helper */
const starSVG = `<svg width="16" height="16" viewBox="0 0 24 24" fill="var(--color-star)" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>`;
---

<BaseLayout
  title="Love Grass Restaurant"
  description="Authentic Ethiopian restaurant in Dubai serving homemade teff injera, Tibs, Kitfo, Doro Wot, and traditional dishes. Experience the flavors of Ethiopia."
  schema={aggregateRatingSchema}
>

  <!-- ========== HERO SECTION ========== -->
  <section class="hero" id="hero" aria-label="Welcome to Love Grass Restaurant">
    <div class="hero__layout container">
      <div class="hero__visual" aria-hidden="true">
        <div class="hero__lottie" id="hero-lottie-container"></div>
      </div>

      <div class="hero__content">
        <p class="hero__label font-accent">From grain to table</p>
        <h1 class="hero__title">Ethiopian tradition, served warm in Dubai.</h1>
        <p class="hero__description">
          Fresh teff injera and time-honoured dishes, made for sharing around one table.
        </p>

        <div class="hero__actions">
          <a href="/menu" class="btn btn--accent btn--lg">
            Explore Our Menu
          </a>
          <a href="#featured" class="hero__scroll-cue" aria-label="Scroll to our signature dishes">
            <span>Discover our dishes</span>
            <svg viewBox="0 0 24 32" aria-hidden="true">
              <path d="M12 2v25M4 19l8 9 8-9"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== FEATURED PRODUCTS ========== -->
  <section class="section featured" id="featured" aria-labelledby="featured-title">
    <div class="container">
      <div class="text-center" data-reveal>
        <p class="section-label">Our Specialties</p>
        <h2 class="section-title" id="featured-title">Signature Dishes</h2>
        <hr class="divider" style="margin-inline: auto;" />
        <p class="section-subtitle" style="margin-inline: auto;">
          Handcrafted with love using traditional recipes and the finest teff flour
        </p>
      </div>

      <div class="featured-grid">
        {featuredItems.map((item, i) => (
          <article class="featured-card card" data-reveal data-reveal-delay={String(Math.min(i + 1, 5))}>
            <div class="featured-card__img img-zoom">
              <div class="featured-card__placeholder" aria-label={item.name}>
                <span class="font-ethiopic">{item.nameAmharic}</span>
              </div>
            </div>
            <div class="featured-card__body">
              <h3 class="featured-card__name">
                {item.name}
                <span class="font-ethiopic featured-card__amharic">{item.nameAmharic}</span>
              </h3>
              <p class="featured-card__desc">{item.description}</p>
              <div class="featured-card__footer">
                <span class="price">
                  <span class="price-currency">AED</span> {item.price}
                </span>
                {item.dietary.length > 0 && (
                  <div class="featured-card__tags">
                    {item.dietary.map(tag => (
                      <span class="dietary-tag">{tag}</span>
                    ))}
                  </div>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>

      <div class="text-center mt-6" data-reveal>
        <a href="/menu" class="btn btn--primary btn--lg">
          View Full Menu
        </a>
      </div>
    </div>
  </section>

  <!-- ========== ATMOSPHERE ========== -->
  <section class="section atmosphere" id="atmosphere" aria-labelledby="atmosphere-title">
    <div class="container">
      <div class="text-center" data-reveal>
        <p class="section-label">The Experience</p>
        <h2 class="section-title" id="atmosphere-title">Our Atmosphere</h2>
        <hr class="divider" style="margin-inline: auto;" />
        <p class="section-subtitle" style="margin-inline: auto;">
          A warm, welcoming space where every meal feels like a gathering with family
        </p>
      </div>

      <div class="atmosphere-grid" data-reveal>
        <div class="atmosphere-item atmosphere-item--large img-zoom">
          <div class="atmosphere-placeholder">
            <span>Restaurant Interior</span>
          </div>
        </div>
        <div class="atmosphere-item img-zoom">
          <div class="atmosphere-placeholder">
            <span>Ethiopian Coffee Ceremony</span>
          </div>
        </div>
        <div class="atmosphere-item img-zoom">
          <div class="atmosphere-placeholder">
            <span>Communal Dining</span>
          </div>
        </div>
        <div class="atmosphere-item img-zoom">
          <div class="atmosphere-placeholder">
            <span>Celebrity Guests</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== GOOGLE REVIEWS ========== -->
  <section class="section reviews" id="reviews" aria-labelledby="reviews-title">
    <div class="container">
      <div class="text-center" data-reveal>
        <p class="section-label">What People Say</p>
        <h2 class="section-title" id="reviews-title">Our Reviews</h2>
        <hr class="divider" style="margin-inline: auto;" />
        <div class="reviews-rating">
          <div class="reviews-stars" aria-label={`Rated ${avgRating} out of 5 stars`}>
            {Array.from({ length: 5 }).map(() => (
              <Fragment set:html={starSVG} />
            ))}
          </div>
          <span class="reviews-avg">{avgRating}</span>
          <span class="text-muted text-sm">based on {reviewsData.length} reviews</span>
        </div>
      </div>

      <div class="reviews-grid">
        {reviewsData.map((review, i) => (
          <article class="review-card card" data-reveal data-reveal-delay={String(Math.min(i + 1, 5))}>
            <div class="review-card__stars" aria-label={`${review.rating} stars`}>
              {Array.from({ length: review.rating }).map(() => (
                <Fragment set:html={starSVG} />
              ))}
            </div>
            <blockquote class="review-card__text">
              <p>"{review.text}"</p>
            </blockquote>
            <footer class="review-card__footer">
              <cite class="review-card__author">{review.author}</cite>
              <span class="review-card__source">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"></path>
                  <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"></path>
                  <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"></path>
                  <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"></path>
                </svg>
                {review.source}
              </span>
            </footer>
          </article>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ========== HERO ========== */
  .hero {
    position: relative;
    min-height: calc(100svh - 64px);
    overflow: hidden;
    background:
      radial-gradient(circle at 18% 15%, rgba(76, 175, 80, 0.2), transparent 34rem),
      linear-gradient(145deg, var(--color-primary) 0%, var(--color-primary-dark) 78%);
  }

  .hero__layout {
    min-height: inherit;
    display: grid;
    grid-template-rows: minmax(260px, 38svh) auto;
    align-items: center;
    padding-block: var(--space-3) var(--space-6);
  }

  .hero__visual {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 260px;
    overflow: visible;
  }

  .hero__visual::after {
    content: '';
    position: absolute;
    inset: auto 3% -3% 3%;
    height: 18%;
    border-radius: 50%;
    background: rgba(12, 42, 14, 0.38);
    filter: blur(24px);
    pointer-events: none;
  }

  .hero__lottie {
    position: absolute;
    inset: 2% -24% -36%;
    transform: scale(0.8);
    transform-origin: center;
  }

  .hero__lottie :global(canvas) {
    width: 100% !important;
    height: 100% !important;
    max-width: none;
    object-fit: contain;
  }

  .hero__content {
    position: relative;
    width: 100%;
    padding-top: var(--space-2);
    text-align: center;
  }

  .hero__label {
    font-size: var(--text-lg);
    color: var(--color-accent-light);
    margin-bottom: var(--space-2);
  }

  .hero__title {
    max-width: 15ch;
    margin-inline: auto;
    font-family: var(--font-heading);
    font-size: clamp(2.25rem, 9vw, 3.5rem);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.035em;
    color: var(--color-text-inverse);
  }

  .hero__description {
    max-width: 36ch;
    margin: var(--space-3) auto 0;
    color: rgba(255, 255, 255, 0.82);
    font-size: var(--text-base);
    line-height: 1.65;
  }

  .hero__actions {
    min-height: 56px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-3);
    justify-content: center;
  }

  .hero__scroll-cue {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-accent-light);
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero__scroll-cue svg {
    width: 18px;
    height: 24px;
    overflow: visible;
    animation: scroll-cue-bob 2.4s var(--ease-in-out) infinite;
  }

  .hero__scroll-cue path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @keyframes scroll-cue-bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(3px); }
  }

  @media (max-width: 420px) {
    .hero__layout {
      grid-template-rows: minmax(230px, 36svh) auto;
      padding-inline: var(--space-3);
    }

    .hero__visual {
      min-height: 230px;
    }

    .hero__scroll-cue span {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
  }

  @media (min-width: 900px) {
    .hero {
      min-height: calc(100svh - 72px);
    }

    .hero__layout {
      grid-template-columns: minmax(0, 58%) minmax(0, 42%);
      grid-template-rows: 1fr;
      gap: 0;
      padding-block: var(--space-5);
    }

    .hero__visual {
      min-height: min(74svh, 720px);
    }

    .hero__lottie {
      inset: -4% -4% -14% -14%;
      transform: translateY(-4%) scale(0.8);
    }

    .hero__content {
      padding-top: 0;
      text-align: left;
      transform: translateX(clamp(-3rem, -3vw, -1.5rem));
    }

    .hero__label {
      text-align: left;
    }

    .hero__title,
    .hero__description {
      margin-inline: 0;
    }

    .hero__title {
      font-size: clamp(3rem, 5vw, 4.5rem);
    }

    .hero__actions {
      flex-direction: row;
      justify-content: flex-start;
      align-items: center;
    }
  }

  @media (min-width: 1200px) {
    .hero__layout {
      grid-template-columns: minmax(0, 60%) minmax(0, 40%);
    }
  }

  /* ========== FEATURED PRODUCTS ========== */
  .featured {
    background-color: var(--color-surface);
  }

  .featured-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  @media (min-width: 480px) {
    .featured-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .featured-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .featured-card__img {
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .featured-card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--color-primary-50), var(--color-primary-100));
    color: var(--color-primary);
    font-family: var(--font-ethiopic);
    font-size: var(--text-2xl);
    font-weight: 600;
  }

  .featured-card__body {
    padding: var(--space-3);
  }

  .featured-card__name {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 600;
    margin-bottom: var(--space-1);
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .featured-card__amharic {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    font-weight: 400;
  }

  .featured-card__desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
    line-height: 1.5;
  }

  .featured-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .featured-card__tags {
    display: flex;
    gap: var(--space-1);
  }

  .dietary-tag {
    font-size: var(--text-xs);
    font-family: var(--font-heading);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 2px var(--space-2);
    border-radius: var(--radius-full);
    background-color: var(--color-primary-50);
    color: var(--color-primary);
  }

  /* ========== ATMOSPHERE ========== */
  .atmosphere {
    background-color: var(--color-surface-alt);
  }

  .atmosphere-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  @media (min-width: 768px) {
    .atmosphere-grid {
      grid-template-columns: repeat(2, 1fr);
      grid-template-rows: auto auto;
    }

    .atmosphere-item--large {
      grid-row: 1 / 3;
    }
  }

  .atmosphere-item {
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .atmosphere-placeholder {
    aspect-ratio: 16 / 10;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--color-primary-dark), var(--color-primary));
    color: var(--color-text-inverse);
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: var(--text-sm);
    opacity: 0.7;
  }

  .atmosphere-item--large .atmosphere-placeholder {
    aspect-ratio: auto;
    height: 100%;
    min-height: 300px;
  }

  /* ========== REVIEWS ========== */
  .reviews {
    background-color: var(--color-surface);
  }

  .reviews-rating {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  .reviews-stars {
    display: flex;
    gap: 2px;
  }

  .reviews-avg {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--color-text);
  }

  .reviews-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  @media (min-width: 768px) {
    .reviews-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .reviews-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .review-card {
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .review-card__stars {
    display: flex;
    gap: 2px;
  }

  .review-card__text {
    flex: 1;
  }

  .review-card__text p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.6;
    font-style: italic;
  }

  .review-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-2);
    border-top: 1px solid var(--color-border-light);
  }

  .review-card__author {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: var(--text-sm);
    font-style: normal;
  }

  .review-card__source {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
</style>

<!-- Hero Lottie animation -->
<script>
  async function initLottie() {
    const container = document.getElementById('hero-lottie-container');
    if (!container) return;

    try {
      const { DotLottie } = await import('@lottiefiles/dotlottie-web');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const canvas = document.createElement('canvas');
      canvas.setAttribute('aria-hidden', 'true');
      container.appendChild(canvas);

      const animation = new DotLottie({
        canvas,
        src: '/lottie/hero-animation.lottie',
        autoplay: !reduceMotion,
        loop: false,
        layout: { fit: 'contain', align: [0.5, 0.65] },
      });

      animation.addEventListener('load', () => {
        if (reduceMotion) {
          animation.setFrame(Math.max(0, animation.totalFrames - 1));
        }
      });

      animation.addEventListener('complete', () => {
        animation.setFrame(Math.max(0, animation.totalFrames - 1));
      });

      animation.addEventListener('loadError', ({ error }) => {
        console.warn('Lottie failed to load:', error);
      });

      animation.addEventListener('renderError', ({ error }) => {
        console.warn('Lottie failed to render:', error);
      });
    } catch (e) {
      console.warn('Lottie failed to load:', e);
    }
  }

  initLottie();
</script>
