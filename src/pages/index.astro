<!-- Hero Lottie animation -->
<script>
  async function initLottie() {
    const container = document.getElementById('hero-lottie-container');
    if (!container) return;

    try {
      const { DotLottie } = await import('@lottiefiles/dotlottie-web');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const canvas = document.createElement('canvas');
      canvas.setAttribute('aria-hidden', 'true');
      container.appendChild(canvas);

      const animation = new DotLottie({
        canvas,
        src: '/lottie/hero-animation.lottie',
        autoplay: !reduceMotion,
        loop: false,
        layout: { fit: 'contain', align: [0.5, 0.65] },
      });

      animation.addEventListener('load', () => {
        if (reduceMotion) {
          animation.setFrame(Math.max(0, animation.totalFrames - 1));
        }
      });

      animation.addEventListener('complete', () => {
        animation.setFrame(Math.max(0, animation.totalFrames - 1));
      });

      animation.addEventListener('loadError', ({ error }) => {
        console.warn('Lottie failed to load:', error);
      });

      animation.addEventListener('renderError', ({ error }) => {
        console.warn('Lottie failed to render:', error);
      });
    } catch (e) {
      console.warn('Lottie failed to load:', e);
    }
  }

  initLottie();
</script>

<!-- Signature dishes editorial rail -->
<script>
  function initFeaturedShowcase() {
    const showcase = document.querySelector<HTMLElement>('[data-featured-showcase]');
    if (!showcase || showcase.dataset.initialized === 'true') return;

    const rail = showcase.querySelector<HTMLElement>('[data-featured-rail]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    if (!rail) return;
    showcase.dataset.initialized = 'true';

    const pixelsPerSecond = 36;
    let direction = 1;
    let position = rail.scrollLeft;
    let interactionPaused = false;
    let animationFrame: number | undefined;
    let resumeTimer: number | undefined;
    let previousTime: number | undefined;

    const stopAnimation = () => {
      if (animationFrame !== undefined) window.cancelAnimationFrame(animationFrame);
      animationFrame = undefined;
      previousTime = undefined;
      rail.classList.remove('is-autoplaying');
    };

    const animate = (time: number) => {
      if (interactionPaused || reduceMotion.matches) {
        stopAnimation();
        return;
      }

      const elapsed = previousTime === undefined ? 0 : Math.min(time - previousTime, 50);
      previousTime = time;
      const maximumScroll = Math.max(0, rail.scrollWidth - rail.clientWidth);
      position += direction * pixelsPerSecond * (elapsed / 1000);

      if (position >= maximumScroll) {
        position = maximumScroll;
        direction = -1;
      } else if (position <= 0) {
        position = 0;
        direction = 1;
      }

      rail.scrollLeft = position;
      animationFrame = window.requestAnimationFrame(animate);
    };

    const startAnimation = () => {
      stopAnimation();
      if (interactionPaused || reduceMotion.matches || document.hidden) return;
      position = rail.scrollLeft;
      rail.classList.add('is-autoplaying');
      animationFrame = window.requestAnimationFrame(animate);
    };

    const pauseForInteraction = () => {
      window.clearTimeout(resumeTimer);
      interactionPaused = true;
      stopAnimation();
    };

    const resumeAfterInteraction = (delay = 400) => {
      window.clearTimeout(resumeTimer);
      resumeTimer = window.setTimeout(() => {
        interactionPaused = false;
        startAnimation();
      }, delay);
    };

    rail.addEventListener('pointerdown', pauseForInteraction, { passive: true });
    window.addEventListener('pointerup', () => resumeAfterInteraction(), { passive: true });
    window.addEventListener('pointercancel', () => resumeAfterInteraction(), { passive: true });
    rail.addEventListener('wheel', () => {
      pauseForInteraction();
      resumeAfterInteraction(700);
    }, { passive: true });
    rail.addEventListener('keydown', (event) => {
      if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
      pauseForInteraction();
    });
    rail.addEventListener('keyup', (event) => {
      if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
      resumeAfterInteraction(250);
    });

    reduceMotion.addEventListener('change', () => {
      if (reduceMotion.matches) stopAnimation();
      else startAnimation();
    });

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stopAnimation();
      else startAnimation();
    });

    startAnimation();
  }

  initFeaturedShowcase();
  document.addEventListener('astro:page-load', initFeaturedShowcase);
</script>

<!-- Infinite portrait atmosphere carousel -->
<script>
  function initAtmosphereCarousel() {
    const carousel = document.querySelector<HTMLElement>('[data-atmosphere-grid]');
    if (!carousel || carousel.dataset.initialized === 'true') return;

    const status = document.querySelector<HTMLElement>('[data-atmosphere-status]');
    const cards = Array.from(carousel.querySelectorAll<HTMLButtonElement>('[data-atmosphere-card]'))
      .sort((a, b) => Number(a.dataset.atmosphereIndex) - Number(b.dataset.atmosphereIndex));
    if (!cards.length) return;

    carousel.dataset.initialized = 'true';

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const ROTATION_DELAY = 3000;
    const INTERACTION_DELAY = 6000;
    let activeIndex = 0;
    let interactionPaused = false;
    let carouselVisible = false;
    let rotationTimer = 0;
    let interactionTimer = 0;

    const stopRotation = () => {
      window.clearTimeout(rotationTimer);
      rotationTimer = 0;
    };

    const canPlayVideos = () =>
      carouselVisible && !document.hidden && !reduceMotion.matches;

    const syncVideos = () => {
      cards.forEach((card, index) => {
        const video = card.querySelector<HTMLVideoElement>('.atmosphere-card__video');
        if (!video) return;

        if (index === activeIndex && canPlayVideos()) {
          const playPromise = video.play();
          playPromise?.catch(() => card.classList.remove('is-playing'));
        } else {
          video.pause();
          card.classList.remove('is-playing');
        }
      });
    };

    const canRotate = () =>
      carouselVisible &&
      !document.hidden &&
      !reduceMotion.matches &&
      !interactionPaused;

    const getCircularPosition = (index: number, centerIndex: number) => {
      let position = index - centerIndex;
      while (position > 2) position -= cards.length;
      while (position < -3) position += cards.length;
      return position;
    };

    const setActive = (nextIndex: number, announce = false) => {
      if (nextIndex < 0 || nextIndex >= cards.length) return;
      activeIndex = nextIndex;

      cards.forEach((card, index) => {
        const position = getCircularPosition(index, activeIndex);
        const previousPosition = Number(card.dataset.carouselPosition);
        const wraps = Number.isFinite(previousPosition) && Math.abs(position - previousPosition) > 1;
        const isActive = index === activeIndex;

        card.classList.toggle('is-wrapping', wraps);
        card.classList.toggle('is-active', isActive);
        card.setAttribute('aria-pressed', String(isActive));
        card.style.setProperty('--carousel-position', String(position));
        card.style.setProperty('--carousel-distance', String(Math.abs(position)));
        card.dataset.carouselPosition = String(position);
        card.dataset.carouselDistance = String(Math.abs(position));
      });

      window.requestAnimationFrame(() => {
        window.requestAnimationFrame(() => cards.forEach((card) => card.classList.remove('is-wrapping')));
      });

      syncVideos();

      if (announce && status) {
        const label = cards[activeIndex].getAttribute('aria-label')?.replace(/^Show /, '') ?? '';
        status.textContent = `${label} centered`;
      }
    };

    const scheduleRotation = () => {
      stopRotation();
      if (!canRotate()) return;

      rotationTimer = window.setTimeout(() => {
        setActive((activeIndex + 1) % cards.length);
        scheduleRotation();
      }, ROTATION_DELAY);
    };

    const syncState = () => {
      syncVideos();
      scheduleRotation();
    };

    const pauseForInteraction = () => {
      interactionPaused = true;
      stopRotation();
      window.clearTimeout(interactionTimer);

      interactionTimer = window.setTimeout(() => {
        interactionPaused = false;
        scheduleRotation();
      }, INTERACTION_DELAY);
    };

    cards.forEach((card, index) => {
      const video = card.querySelector<HTMLVideoElement>('.atmosphere-card__video');
      video?.addEventListener('playing', () => card.classList.add('is-playing'));
      video?.addEventListener('pause', () => card.classList.remove('is-playing'));

      card.addEventListener('click', () => {
        setActive(index, true);
        pauseForInteraction();
      });
    });

    const observer = new IntersectionObserver(
      ([entry]) => {
        carouselVisible = entry.isIntersecting;
        syncState();
      },
      { threshold: 0.2 }
    );
    observer.observe(carousel);

    reduceMotion.addEventListener('change', () => {
      if (reduceMotion.matches) {
        interactionPaused = false;
        window.clearTimeout(interactionTimer);
      }
      syncState();
    });

    document.addEventListener('visibilitychange', syncState);
    setActive(0);
    syncVideos();
  }

  initAtmosphereCarousel();
  document.addEventListener('astro:page-load', initAtmosphereCarousel);
</script>
