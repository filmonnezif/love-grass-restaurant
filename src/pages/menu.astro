---
import BaseLayout from '../layouts/BaseLayout.astro';
import menuData from '../data/menu.json';
import { Image } from 'astro:assets';

import loveGrassSpecialImg from '../assets/food/love-grass-special.png';
import specialKitfoImg from '../assets/food/special-kitfo.png';
import maheberawiImg from '../assets/food/maheberawi.png';
import derekTibsImg from '../assets/food/derek-tibs.png';
import teffCakeImg from '../assets/food/teff-cake.png';
import teffBerryDelightImg from '../assets/food/teff-berry-delight.png';
import doroWotImg from '../assets/food/doro-wot.png';
import beyeyanetuImg from '../assets/food/beyeyanetu.png';
import yebegTibsImg from '../assets/food/yebeg-tibs.png';
import extraInjeraImg from '../assets/food/extra-injera.png';
import ethiopianSaladImg from '../assets/food/ethiopian-salad.png';
import sambusaImg from '../assets/food/sambusa.png';
import bunaImg from '../assets/food/buna.png';
import tejImg from '../assets/food/tej.png';
import sprisImg from '../assets/food/spris.png';

const foodImages: Record<string, ImageMetadata> = {
  'love-grass-special.png': loveGrassSpecialImg,
  'special-kitfo.png': specialKitfoImg,
  'maheberawi.png': maheberawiImg,
  'derek-tibs.png': derekTibsImg,
  'teff-cake.png': teffCakeImg,
  'teff-berry-delight.png': teffBerryDelightImg,
  'doro-wot.png': doroWotImg,
  'beyeyanetu.png': beyeyanetuImg,
  'yebeg-tibs.png': yebegTibsImg,
  'extra-injera.png': extraInjeraImg,
  'ethiopian-salad.png': ethiopianSaladImg,
  'sambusa.png': sambusaImg,
  'buna.png': bunaImg,
  'tej.png': tejImg,
  'spris.png': sprisImg,
};

const featureTagLabel = (tags: string[]) => {
  if (tags.includes('signature')) return 'House Signature';
  if (tags.includes('popular')) return 'Guest Favourite';
  return null;
};

const dietaryLabels: Record<string, string> = {
  vegan: 'Vegan',
  vegetarian: 'Vegetarian',
  'gluten-free': 'Gluten-free',
};

/* Build Menu + MenuItem schema from data */
const menuSchema = {
  "@context": "https://schema.org",
  "@type": "Menu",
  "name": "Love Grass Restaurant Menu",
  "hasMenuSection": menuData.sections.map(section => ({
    "@type": "MenuSection",
    "name": section.name,
    "description": section.description,
    "hasMenuItem": section.items.map(item => ({
      "@type": "MenuItem",
      "name": item.name,
      "description": item.description,
      ...(item.dietary.includes('vegan') && {
        "suitableForDiet": "https://schema.org/VeganDiet"
      }),
      ...(item.dietary.includes('vegetarian') && {
        "suitableForDiet": "https://schema.org/VegetarianDiet"
      }),
      ...(item.dietary.includes('gluten-free') && {
        "suitableForDiet": "https://schema.org/GlutenFreeDiet"
      }),
      "offers": {
        "@type": "Offer",
        "price": String(item.price),
        "priceCurrency": item.currency
      }
    }))
  }))
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://love-grass.com/" },
    { "@type": "ListItem", "position": 2, "name": "Menu", "item": "https://love-grass.com/menu" }
  ]
};
---

<BaseLayout
  title="Menu"
  description="Explore our authentic Ethiopian menu featuring homemade teff injera, Tibs, Kitfo, Doro Wot, Beyeyanetu, and traditional beverages. All prices in AED."
  schema={[menuSchema, breadcrumbSchema]}
>
  <section class="menu-hero" aria-labelledby="menu-hero-title">
    <div class="menu-hero__pattern" aria-hidden="true"></div>
    <div class="menu-hero__content container">
      <p class="menu-hero__label font-accent hero-animate">Taste of Ethiopia</p>
      <h1 class="menu-hero__title hero-animate hero-animate--delay-1" id="menu-hero-title">Our Menu</h1>
      <p class="menu-hero__subtitle hero-animate hero-animate--delay-2">
        Authentic Ethiopian dishes, prepared with care and served on homemade teff injera.
      </p>
    </div>
  </section>

  <nav class="menu-nav" aria-label="Browse menu categories" data-menu-nav>
    <div class="container menu-nav__inner">
      <span class="menu-nav__label" aria-hidden="true">Browse by</span>
      <ul class="menu-nav__list" role="list">
        {menuData.sections.map((section, index) => (
          <li>
            <a
              href={`#${section.id}`}
              class:list={['menu-nav__link', { 'is-active': index === 0 }]}
              data-menu-link={section.id}
              aria-current={index === 0 ? 'location' : undefined}
            >
              <span>{String(index + 1).padStart(2, '0')}</span>
              {section.name}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>

  <div class="menu-catalogue">
    {menuData.sections.map((section, sectionIndex) => (
      <section
        class:list={['menu-section', `menu-section--${section.id}`]}
        id={section.id}
        aria-labelledby={`${section.id}-title`}
        data-menu-section
      >
        <div class="container">
          <header class="menu-section__header" data-reveal data-menu-section-header>
            <div class="menu-section__index" aria-hidden="true">
              {String(sectionIndex + 1).padStart(2, '0')}
            </div>
            <div class="menu-section__intro">
              <p class="menu-section__amharic font-ethiopic">{section.nameAmharic}</p>
              <h2 class="menu-section__title" id={`${section.id}-title`}>{section.name}</h2>
              <p class="menu-section__description">{section.description}</p>
            </div>
          </header>

          <div class="menu-items-grid">
            {section.items.map((item, itemIndex) => {
              const image = foodImages[item.image];
              const featureLabel = featureTagLabel(item.tags);

              return (
                <article
                  class:list={['menu-item', { 'menu-item--featured': featureLabel }]}
                  id={`dish-${item.id}`}
                  data-menu-card
                  data-card-order={String(itemIndex)}
                >
                  <div class="menu-item__visual">
                    {featureLabel && <span class="menu-item__feature">{featureLabel}</span>}
                    <span class="menu-item__number" aria-hidden="true">
                      {String(itemIndex + 1).padStart(2, '0')}
                    </span>
                    <Image
                      src={image}
                      alt={`${item.name}, plated and ready to serve`}
                      width={560}
                      height={560}
                      loading="lazy"
                      decoding="async"
                      class:list={[
                        'menu-item__image',
                        { 'menu-item__image--wide': item.id === 'derek-tibs' },
                        { 'menu-item__image--cake': item.id === 'teff-cake' },
                        { 'menu-item__image--drink': section.id === 'drinks' },
                      ]}
                    />
                  </div>

                  <div class="menu-item__body">
                    <p class="menu-item__amharic font-ethiopic">{item.nameAmharic}</p>
                    <div class="menu-item__heading">
                      <h3 class="menu-item__name">{item.name}</h3>
                      <p class="menu-item__price" aria-label={`${item.price} ${item.currency}`}>
                        <span>{item.currency}</span> {item.price}
                      </p>
                    </div>
                    <p class="menu-item__description">{item.description}</p>
                    <div class="menu-item__footer">
                      {item.dietary.length > 0 ? (
                        <ul class="menu-item__tags" aria-label="Dietary information">
                          {item.dietary.map(tag => (
                            <li class="dietary-tag">{dietaryLabels[tag] ?? tag}</li>
                          ))}
                        </ul>
                      ) : (
                        <span class="menu-item__flourish" aria-hidden="true"></span>
                      )}
                    </div>
                  </div>
                </article>
              );
            })}
          </div>
        </div>
      </section>
    ))}
  </div>

</BaseLayout>

<style>
  .menu-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    color: var(--color-text-inverse);
    background:
      radial-gradient(circle at 82% 35%, rgba(83, 158, 76, 0.32), transparent 28rem),
      var(--color-primary-dark);
  }

  .menu-hero__pattern {
    position: absolute;
    z-index: -1;
    inset: 0;
    opacity: 0.08;
    background-image: radial-gradient(rgba(255, 255, 255, 0.8) 0.7px, transparent 0.7px);
    background-size: 15px 15px;
    mask-image: linear-gradient(90deg, #000, transparent 78%);
    animation: menu-pattern-drift 22s linear infinite alternate;
  }

  @keyframes menu-pattern-drift {
    from { background-position: 0 0; }
    to { background-position: 30px 18px; }
  }

  .menu-hero__content {
    position: relative;
    z-index: 1;
    min-height: 290px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding-block: var(--space-6);
    text-align: left;
  }

  .menu-hero__label {
    margin-bottom: var(--space-2);
    color: var(--color-accent-light);
    font-size: var(--text-lg);
  }

  .menu-hero__title {
    color: var(--color-text-inverse);
    font-size: clamp(3rem, 9vw, 5rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1;
  }

  .menu-hero__subtitle {
    max-width: 52ch;
    margin-top: var(--space-3);
    color: rgba(255, 255, 255, 0.78);
    font-size: var(--text-base);
    line-height: 1.65;
  }

  .menu-nav {
    position: sticky;
    top: 64px;
    z-index: var(--z-dropdown);
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    border-bottom: 1px solid var(--color-border-light);
    background: rgba(250, 250, 245, 0.96);
    backdrop-filter: blur(14px);
    scrollbar-width: none;
  }

  .menu-nav::-webkit-scrollbar {
    display: none;
  }

  .menu-nav__inner {
    display: flex;
    align-items: center;
    min-width: max-content;
  }

  .menu-nav__label {
    display: none;
    margin-right: var(--space-4);
    color: var(--color-text-muted);
    font-family: var(--font-accent);
    font-style: italic;
    font-size: var(--text-sm);
  }

  .menu-nav__list {
    display: flex;
    gap: var(--space-1);
    padding-block: var(--space-2);
  }

  .menu-nav__link {
    position: relative;
    min-height: 44px;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-full);
    color: var(--color-text-muted);
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 600;
    transition:
      color var(--duration-fast),
      background-color var(--duration-fast),
      transform var(--duration-fast) var(--ease-out);
  }

  .menu-nav__link span {
    color: var(--color-accent-warm);
    font-size: 0.68rem;
    font-variant-numeric: tabular-nums;
  }

  .menu-nav__link:hover,
  .menu-nav__link.is-active {
    color: var(--color-primary-dark);
    background: var(--color-primary-50);
  }

  .menu-nav__link::after {
    content: '';
    position: absolute;
    left: var(--space-3);
    right: var(--space-3);
    bottom: 4px;
    height: 2px;
    border-radius: var(--radius-full);
    background: var(--color-primary);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform var(--duration-normal) var(--ease-out);
  }

  .menu-nav__link.is-active::after {
    transform: scaleX(1);
  }

  .menu-section {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: var(--space-7);
    scroll-margin-top: 132px;
  }

  .menu-section::before {
    content: '';
    position: absolute;
    z-index: -1;
    width: 32rem;
    aspect-ratio: 1;
    top: -20rem;
    right: -19rem;
    border-radius: 50%;
    opacity: 0.48;
    background: repeating-radial-gradient(
      circle,
      transparent 0 16px,
      rgba(53, 122, 56, 0.09) 17px 18px
    );
    mask-image: radial-gradient(circle, #000 18%, transparent 68%);
  }

  .menu-section--injera-platters {
    background: var(--color-surface);
  }

  .menu-section--sides {
    background: #f1ede3;
  }

  .menu-section--drinks {
    background: linear-gradient(145deg, #e9f1e7, #f4f3e9 78%);
  }

  .menu-section__header {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: var(--space-3);
    max-width: 760px;
  }

  .menu-section__index {
    padding-top: 0.26rem;
    color: var(--color-accent);
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .menu-section__amharic {
    margin-bottom: var(--space-1);
    color: var(--color-accent-warm);
    font-size: var(--text-base);
  }

  .menu-section__title {
    position: relative;
    display: inline-block;
    margin-bottom: var(--space-3);
    color: var(--color-primary-dark);
    font-size: var(--text-4xl);
    letter-spacing: -0.025em;
  }

  .menu-section__title::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: calc(var(--space-2) * -1);
    width: 52px;
    height: 3px;
    border-radius: var(--radius-full);
    background: linear-gradient(90deg, var(--color-primary), var(--color-accent));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 600ms var(--ease-out);
  }

  .menu-section__header.revealed .menu-section__title::after {
    transform: scaleX(1);
  }

  @supports (animation-timeline: view()) {
    @keyframes menu-divider-grow {
      from { transform: scaleX(0); }
      to { transform: scaleX(1); }
    }

    .menu-section__title::after {
      animation: menu-divider-grow 1ms linear both;
      animation-timeline: view();
      animation-range: entry 18% cover 30%;
    }
  }

  .menu-section__description {
    max-width: 56ch;
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }

  .menu-items-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  .menu-item {
    --settle-y: 10px;
    --card-delay: 0ms;
    --pointer-x: 50%;
    --pointer-y: 35%;
    position: relative;
    min-width: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 0;
    border-radius: var(--radius-xl);
    background: var(--color-primary-dark);
    box-shadow: 0 12px 32px rgba(25, 67, 29, 0.13);
    opacity: 1;
    transform: translateY(var(--settle-y));
    transition:
      transform 520ms var(--ease-out) var(--card-delay),
      box-shadow var(--duration-normal) var(--ease-out);
  }

  .menu-item::after {
    content: '';
    position: absolute;
    z-index: 4;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(
      circle 230px at var(--pointer-x) var(--pointer-y),
      rgba(255, 255, 255, 0.15),
      rgba(255, 255, 255, 0.04) 38%,
      transparent 72%
    );
    opacity: 0;
    pointer-events: none;
    transition: opacity 240ms var(--ease-out);
  }

  .menu-item.is-settled {
    --settle-y: 0px;
  }

  .menu-item.is-pointer-active::after {
    opacity: 1;
  }

  .menu-item:hover {
    transform: translateY(calc(var(--settle-y) - 4px));
    box-shadow: 0 22px 48px rgba(25, 67, 29, 0.2);
  }

  .menu-item:active {
    transform: translateY(var(--settle-y)) scale(0.992);
  }

  .menu-item__visual {
    position: relative;
    z-index: 1;
    isolation: isolate;
    min-height: 250px;
    display: grid;
    place-items: center;
    overflow: visible;
    padding: var(--space-4) var(--space-4) 0;
    background:
      radial-gradient(circle at 50% 58%, rgba(200, 230, 201, 0.86), transparent 48%),
      linear-gradient(155deg, rgba(250, 250, 245, 0.9), rgba(232, 245, 233, 0.8));
  }

  .menu-item__visual::before {
    content: '';
    position: absolute;
    z-index: -1;
    width: 72%;
    aspect-ratio: 1;
    border: 1px solid rgba(53, 122, 56, 0.12);
    border-radius: 50%;
  }

  .menu-item__feature {
    position: absolute;
    z-index: 2;
    top: var(--space-3);
    left: var(--space-3);
    padding: 0.35rem 0.65rem;
    border: 1px solid rgba(53, 122, 56, 0.16);
    border-radius: var(--radius-full);
    color: var(--color-primary-dark);
    background: rgba(250, 250, 245, 0.84);
    backdrop-filter: blur(8px);
    font-family: var(--font-heading);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .menu-item__number {
    position: absolute;
    z-index: 2;
    top: var(--space-3);
    right: var(--space-3);
    color: rgba(33, 82, 35, 0.36);
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .menu-item__image {
    position: relative;
    z-index: 1;
    width: min(100%, 300px);
    height: 220px;
    object-fit: contain;
    filter: drop-shadow(0 24px 20px rgba(12, 43, 16, 0.38));
    transform: translateY(50px) scale(1.07);
    transition: transform 600ms var(--ease-out), filter 600ms var(--ease-out);
  }

  .menu-item:hover .menu-item__image {
    transform: translateY(39px) scale(1.11) rotate(-0.5deg);
    filter: drop-shadow(0 31px 24px rgba(10, 39, 14, 0.46));
  }

  .menu-item__image--wide {
    width: min(100%, 330px);
  }

  .menu-item__image--cake {
    width: min(96%, 290px);
  }

  .menu-item__image--drink {
    height: 230px;
  }

  .menu-item__body {
    position: relative;
    z-index: 0;
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: calc(var(--space-6) + var(--space-2)) var(--space-4) var(--space-4);
    color: var(--color-text-inverse);
    background: linear-gradient(145deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
  }

  .menu-item__amharic {
    min-height: 1.5em;
    margin-bottom: var(--space-1);
    color: var(--color-accent-light);
    font-size: var(--text-sm);
  }

  .menu-item__heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .menu-item__name {
    color: var(--color-text-inverse);
    font-size: var(--text-xl);
    line-height: 1.2;
  }

  .menu-item__price {
    flex: 0 0 auto;
    color: var(--color-accent-light);
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: 1.25;
    white-space: nowrap;
  }

  .menu-item__price span {
    color: rgba(255, 255, 255, 0.64);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  .menu-item__description {
    flex: 1;
    margin-top: var(--space-2);
    color: rgba(255, 255, 255, 0.74);
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  .menu-item__footer {
    min-height: 31px;
    display: flex;
    align-items: flex-end;
    margin-top: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }

  .menu-item__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .menu-item .dietary-tag {
    padding: 0.24rem 0.55rem;
    border: 1px solid rgba(232, 245, 233, 0.24);
    border-radius: var(--radius-full);
    color: #e6f4e7;
    background: rgba(232, 245, 233, 0.12);
    font-family: var(--font-heading);
    font-size: 0.68rem;
    font-weight: 600;
  }

  .menu-item__flourish {
    width: 38px;
    height: 2px;
    border-radius: var(--radius-full);
    background: var(--color-accent-light);
    opacity: 0.75;
  }

  @media (min-width: 700px) {
    .menu-nav__label {
      display: inline;
    }

    .menu-items-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .menu-section {
      padding-block: var(--space-8);
      scroll-margin-top: 144px;
    }

    .menu-section__header {
      gap: var(--space-4);
    }
  }

  @media (min-width: 768px) {
    .menu-nav {
      top: 72px;
    }
  }

  @media (min-width: 1080px) {
    .menu-items-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .menu-item__visual {
      min-height: 280px;
    }

    .menu-item__image {
      height: 235px;
    }
  }

  @media (hover: none) {
    .menu-item:hover {
      transform: translateY(var(--settle-y));
      box-shadow: 0 12px 32px rgba(25, 67, 29, 0.13);
    }

    .menu-item:hover .menu-item__image {
      transform: translateY(50px) scale(1.07);
      filter: drop-shadow(0 24px 20px rgba(12, 43, 16, 0.38));
    }

    .menu-item:active {
      transform: translateY(var(--settle-y)) scale(0.992);
    }

    .menu-item:active .menu-item__image {
      transform: translateY(47px) scale(1.055);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-hero__pattern,
    .menu-section__title::after {
      animation: none;
    }

    .menu-section__title::after {
      transform: scaleX(1);
    }

    .menu-item,
    .menu-item__image,
    .menu-item::after,
    .menu-nav__link,
    .menu-nav__link::after {
      transition: none;
    }

    .menu-item,
    .menu-item:hover,
    .menu-item:active {
      --settle-y: 0px;
      transform: none;
    }

    .menu-item::after {
      display: none;
    }

    .menu-item:hover .menu-item__image,
    .menu-item:active .menu-item__image {
      transform: translateY(50px) scale(1.07);
      filter: drop-shadow(0 24px 20px rgba(12, 43, 16, 0.38));
    }
  }
</style>

<script>
  const menuNav = document.querySelector<HTMLElement>('[data-menu-nav]');
  const menuSections = Array.from(document.querySelectorAll<HTMLElement>('[data-menu-section]'));
  const menuLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-menu-link]'));
  const menuCards = Array.from(document.querySelectorAll<HTMLElement>('[data-menu-card]'));
  const menuGrids = Array.from(document.querySelectorAll<HTMLElement>('.menu-items-grid'));
  const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
  const finePointerQuery = window.matchMedia('(hover: hover) and (pointer: fine)');

  const updateCardDelays = () => {
    menuGrids.forEach((grid) => {
      const columns = getComputedStyle(grid).gridTemplateColumns.split(' ').length;
      const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-menu-card]'));

      cards.forEach((card, index) => {
        const columnIndex = columns > 1 ? index % columns : 0;
        card.style.setProperty('--card-delay', `${columnIndex * 60}ms`);
      });
    });
  };

  updateCardDelays();

  if ('ResizeObserver' in window) {
    const gridResizeObserver = new ResizeObserver(updateCardDelays);
    menuGrids.forEach(grid => gridResizeObserver.observe(grid));
  } else {
    window.addEventListener('resize', updateCardDelays, { passive: true });
  }

  if (reducedMotionQuery.matches || !('IntersectionObserver' in window)) {
    menuCards.forEach(card => card.classList.add('is-settled'));
  } else {
    const cardObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting || !(entry.target instanceof HTMLElement)) return;
          entry.target.classList.add('is-settled');
          cardObserver.unobserve(entry.target);
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -36px 0px' }
    );

    menuCards.forEach(card => cardObserver.observe(card));
  }

  if (finePointerQuery.matches && !reducedMotionQuery.matches) {
    menuCards.forEach((card) => {
      let pointerFrame = 0;
      let pointerX = 0;
      let pointerY = 0;

      card.addEventListener('pointerenter', () => card.classList.add('is-pointer-active'));
      card.addEventListener('pointerleave', () => {
        card.classList.remove('is-pointer-active');
        card.style.removeProperty('--pointer-x');
        card.style.removeProperty('--pointer-y');
      });

      card.addEventListener('pointermove', (event) => {
        pointerX = event.clientX;
        pointerY = event.clientY;
        if (pointerFrame) return;

        pointerFrame = requestAnimationFrame(() => {
          const bounds = card.getBoundingClientRect();
          const x = ((pointerX - bounds.left) / bounds.width) * 100;
          const y = ((pointerY - bounds.top) / bounds.height) * 100;
          card.style.setProperty('--pointer-x', `${x}%`);
          card.style.setProperty('--pointer-y', `${y}%`);
          pointerFrame = 0;
        });
      });
    });
  }

  const setActiveCategory = (sectionId: string) => {
    menuLinks.forEach((link) => {
      const isActive = link.dataset.menuLink === sectionId;
      link.classList.toggle('is-active', isActive);
      if (isActive) {
        link.setAttribute('aria-current', 'location');
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        link.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'nearest', inline: 'center' });
      } else {
        link.removeAttribute('aria-current');
      }
    });
  };

  if (menuSections.length && menuLinks.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter(entry => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio);

        if (visible[0]?.target instanceof HTMLElement) {
          setActiveCategory(visible[0].target.id);
        }
      },
      { rootMargin: '-145px 0px -58% 0px', threshold: [0, 0.05, 0.2, 0.45] }
    );

    menuSections.forEach(section => observer.observe(section));

    menuLinks.forEach(link => {
      link.addEventListener('click', () => {
        const sectionId = link.dataset.menuLink;
        if (sectionId) setActiveCategory(sectionId);
      });
    });
  }

  if (menuNav) {
    menuNav.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;

      const currentIndex = menuLinks.indexOf(document.activeElement as HTMLAnchorElement);
      if (currentIndex === -1) return;

      event.preventDefault();
      const direction = event.key === 'ArrowRight' ? 1 : -1;
      const nextIndex = (currentIndex + direction + menuLinks.length) % menuLinks.length;
      menuLinks[nextIndex]?.focus();
    });
  }
</script>
