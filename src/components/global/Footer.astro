---
const currentYear = new Date().getFullYear();

const mapUrl = 'https://maps.app.goo.gl/yLSnkjwJN55eG1WY7';
const instagramUrl = 'https://www.instagram.com/lovegrassrestaurant';
const tiktokUrl = 'https://www.tiktok.com/@lovegrass_restaurant';
const whatsappUrl = 'https://wa.me/971547910445';
---

<footer class="site-footer" id="contact">
  <div class="footer-glow" aria-hidden="true"></div>

  <div class="container footer-main">
    <section class="footer-intro" aria-labelledby="footer-title">
      <a href="/" class="footer-brand" aria-label="Love Grass Restaurant — Home">
        <img
          src="/images/logo.webp"
          alt=""
          width="56"
          height="56"
          loading="lazy"
          class="footer-logo"
        />
        <span>
          <strong>Love Grass Restaurant</strong>
          <small class="font-ethiopic">እንጀራ መጋገሪያ ቤት</small>
        </span>
      </a>

      <p class="footer-kicker">Come share a table</p>
      <h2 id="footer-title">Ethiopian warmth,<br />right here in Dubai.</h2>
      <p class="footer-copy">
        Homemade injera, time-honoured dishes, and a place that feels like home.
      </p>

      <div class="footer-socials" aria-label="Follow Love Grass Restaurant">
        <a
          href={instagramUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Follow us on Instagram (opens in a new tab)"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="5"></rect>
            <circle cx="12" cy="12" r="4"></circle>
            <circle cx="17.5" cy="6.5" r="1" class="icon-fill"></circle>
          </svg>
          <span>Instagram</span>
        </a>
        <a
          href={tiktokUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Follow us on TikTok (opens in a new tab)"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M15 4v10.25a4.75 4.75 0 1 1-4-4.69"></path>
            <path d="M15 4c.55 2.53 2.13 4 4.5 4.5"></path>
          </svg>
          <span>TikTok</span>
        </a>
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Message us on WhatsApp (opens in a new tab)"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20.5 11.7a8.5 8.5 0 0 1-12.6 7.45L3 20.5l1.3-4.75A8.5 8.5 0 1 1 20.5 11.7Z"></path>
            <path d="M8.1 7.8c.2-.45.4-.46.72-.47h.62c.2 0 .4.08.5.36l.72 1.75c.08.2.05.38-.08.56l-.55.72c-.16.2-.1.4.02.57.7 1.15 1.7 2.04 2.87 2.64.22.11.4.1.56-.1l.8-.98c.17-.2.38-.25.6-.16l1.73.82c.23.1.38.2.4.36.05.72-.26 1.52-.78 1.97-.5.43-1.17.68-1.87.68-1.15 0-2.83-.7-4.45-2.15-1.94-1.74-2.88-3.72-2.78-4.83.06-.67.38-1.28.68-1.72Z"></path>
          </svg>
          <span>WhatsApp</span>
        </a>
      </div>
    </section>

    <section class="footer-panel" aria-labelledby="visit-title">
      <p class="footer-label" id="visit-title">Visit &amp; contact</p>

      <a
        href={mapUrl}
        class="directions-link"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="footer-icon">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"></path>
            <circle cx="12" cy="10" r="2.5"></circle>
          </svg>
        </span>
        <span>
          <strong>Find us on Google Maps</strong>
          <small>Dubai, United Arab Emirates</small>
        </span>
        <svg class="arrow-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M5 12h14M14 7l5 5-5 5"></path>
        </svg>
      </a>

      <address class="contact-list">
        <a href="tel:+971547910445">
          <span class="footer-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z"></path>
            </svg>
          </span>
          <span><small>Mobile</small>054 791 0445</span>
        </a>
        <a href="tel:+97142366092">
          <span class="footer-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z"></path>
            </svg>
          </span>
          <span><small>Landline</small>04 236 6092</span>
        </a>
      </address>
    </section>

    <section class="footer-hours" aria-labelledby="hours-title">
      <p class="footer-label" id="hours-title">Opening hours</p>
      <dl>
        <div>
          <dt>Mon – Thu</dt>
          <dd>11am – 11pm</dd>
        </div>
        <div>
          <dt>Fri – Sat</dt>
          <dd>11am – 12am</dd>
        </div>
        <div>
          <dt>Sunday</dt>
          <dd>12pm – 11pm</dd>
        </div>
      </dl>
      <p class="hours-note">
        <span aria-hidden="true"></span>
        We look forward to welcoming you
      </p>
    </section>
  </div>

  <div class="container footer-bottom">
    <p>&copy; {currentYear} Love Grass Restaurant LLC</p>
    <nav aria-label="Footer navigation">
      <a href="/">Home</a>
      <a href="/menu">Menu</a>
      <a href="/about">About</a>
      <a href="/about#faq">FAQ</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    margin-top: auto;
    color: var(--color-text-inverse);
    background:
      linear-gradient(145deg, rgba(255, 255, 255, 0.025), transparent 42%),
      #173f22;
  }

  .footer-glow {
    position: absolute;
    z-index: -1;
    top: -14rem;
    left: -12rem;
    width: 34rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(212, 148, 58, 0.16), transparent 68%);
    pointer-events: none;
  }

  .footer-main {
    display: grid;
    gap: var(--space-6);
    padding-block: clamp(3.5rem, 8vw, 6.5rem);
  }

  .footer-intro {
    max-width: 34rem;
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: var(--space-5);
  }

  .footer-logo {
    width: 48px;
    height: 48px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: var(--radius-full);
  }

  .footer-brand span {
    display: grid;
    gap: 0.05rem;
  }

  .footer-brand strong {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    line-height: 1.2;
  }

  .footer-brand small {
    color: rgba(250, 250, 245, 0.62);
    font-size: 0.72rem;
  }

  .footer-kicker,
  .footer-label {
    color: var(--color-accent-light);
    font-family: var(--font-heading);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .footer-intro h2 {
    margin-top: 0.65rem;
    color: var(--color-text-inverse);
    font-size: clamp(2rem, 5vw, 3.35rem);
    font-weight: 550;
    letter-spacing: -0.035em;
    line-height: 1.02;
  }

  .footer-copy {
    max-width: 42ch;
    margin-top: var(--space-3);
    color: rgba(250, 250, 245, 0.66);
    font-size: var(--text-sm);
  }

  .footer-socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: var(--space-5);
  }

  .footer-socials a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 42px;
    padding: 0.55rem 0.85rem;
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: var(--radius-full);
    color: rgba(250, 250, 245, 0.78);
    font-size: var(--text-xs);
    transition:
      color var(--duration-fast) ease,
      border-color var(--duration-fast) ease,
      background-color var(--duration-fast) ease,
      transform var(--duration-fast) ease;
  }

  .footer-socials svg {
    width: 17px;
    height: 17px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
  }

  .footer-socials .icon-fill {
    fill: currentColor;
    stroke: none;
  }

  .footer-socials a:hover {
    color: #fff;
    border-color: rgba(232, 184, 109, 0.55);
    background: rgba(232, 184, 109, 0.09);
    transform: translateY(-2px);
  }

  .footer-panel,
  .footer-hours {
    align-self: end;
  }

  .footer-label {
    margin-bottom: var(--space-4);
  }

  .directions-link {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.8rem;
    padding: 0.9rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.055);
    transition:
      border-color var(--duration-fast) ease,
      background-color var(--duration-fast) ease;
  }

  .directions-link strong,
  .directions-link small,
  .contact-list small {
    display: block;
  }

  .directions-link strong {
    font-size: var(--text-sm);
    font-weight: 550;
  }

  .directions-link small,
  .contact-list small {
    margin-bottom: 0.05rem;
    color: rgba(250, 250, 245, 0.52);
    font-size: 0.7rem;
  }

  .footer-icon {
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border-radius: var(--radius-full);
    color: var(--color-accent-light);
    background: rgba(232, 184, 109, 0.1);
  }

  .footer-icon svg,
  .arrow-icon {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
  }

  .arrow-icon {
    color: rgba(250, 250, 245, 0.44);
    transition: transform var(--duration-fast) ease;
  }

  .directions-link:hover {
    border-color: rgba(232, 184, 109, 0.42);
    background: rgba(255, 255, 255, 0.08);
  }

  .directions-link:hover .arrow-icon {
    transform: translateX(3px);
  }

  .contact-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2);
    margin-top: var(--space-3);
    font-style: normal;
  }

  .contact-list a {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    min-width: 0;
    padding: 0.6rem;
    border-radius: var(--radius-md);
    color: rgba(250, 250, 245, 0.82);
    font-size: var(--text-xs);
    transition: background-color var(--duration-fast) ease;
  }

  .contact-list a:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.055);
  }

  .contact-list .footer-icon {
    width: 34px;
    height: 34px;
    flex: 0 0 auto;
  }

  .footer-hours dl {
    display: grid;
  }

  .footer-hours dl div {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block: 0.75rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.09);
    font-size: var(--text-sm);
  }

  .footer-hours dt {
    color: rgba(250, 250, 245, 0.55);
  }

  .footer-hours dd {
    font-weight: 500;
    white-space: nowrap;
  }

  .hours-note {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: var(--space-3);
    color: rgba(250, 250, 245, 0.5);
    font-size: 0.7rem;
  }

  .hours-note span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #7fc880;
    box-shadow: 0 0 0 4px rgba(127, 200, 128, 0.1);
  }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    padding-block: var(--space-4);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    color: rgba(250, 250, 245, 0.46);
    font-size: var(--text-xs);
  }

  .footer-bottom nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .footer-bottom a {
    transition: color var(--duration-fast) ease;
  }

  .footer-bottom a:hover {
    color: var(--color-text-inverse);
  }

  .site-footer a:focus-visible {
    outline: 2px solid var(--color-accent-light);
    outline-offset: 4px;
  }

  @media (max-width: 420px) {
    .contact-list {
      grid-template-columns: 1fr;
    }
  }

  @media (min-width: 720px) {
    .footer-main {
      grid-template-columns: minmax(0, 1.2fr) minmax(18rem, 1fr);
    }

    .footer-intro {
      grid-row: span 2;
    }

    .footer-bottom {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  @media (min-width: 1080px) {
    .footer-main {
      grid-template-columns: minmax(22rem, 1.35fr) minmax(22rem, 1fr) minmax(15rem, 0.72fr);
      align-items: end;
      gap: clamp(2.5rem, 5vw, 5rem);
    }

    .footer-intro {
      grid-row: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-socials a,
    .arrow-icon {
      transition: none;
    }
  }
</style>
