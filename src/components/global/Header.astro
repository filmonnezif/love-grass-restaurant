---
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/menu', label: 'Menu' },
  { href: '/about', label: 'About Us' },
];
---

<header class="site-header" id="site-header">
  <nav class="site-nav container" aria-label="Main navigation">
    <a href="/" class="site-logo" aria-label="Love Grass Restaurant — Home">
      <img
        src="/images/logo.webp"
        alt="Love Grass Restaurant"
        width="48"
        height="48"
        class="site-logo__img"
      />
      <span class="site-logo__text">Love Grass</span>
    </a>

    <ul class="nav-links" id="nav-links" role="list">
      {navLinks.map(link => (
        <li>
          <a
            href={link.href}
            class:list={['nav-link', { active: currentPath === link.href }]}
            aria-current={currentPath === link.href ? 'page' : undefined}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <a href="/menu" class="btn btn--primary nav-cta">
      View Menu
    </a>

    <button
      class="nav-toggle"
      id="nav-toggle"
      aria-expanded="false"
      aria-controls="nav-links"
      aria-label="Toggle navigation menu"
      type="button"
    >
      <span class="nav-toggle__bar"></span>
      <span class="nav-toggle__bar"></span>
      <span class="nav-toggle__bar"></span>
    </button>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    background-color: rgba(250, 250, 245, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border-light);
    transition: box-shadow var(--duration-normal) var(--ease-out);
  }

  .site-header.scrolled {
    box-shadow: var(--shadow-sm);
  }

  .site-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
    gap: var(--space-4);
  }

  /* Logo */
  .site-logo {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-shrink: 0;
  }

  .site-logo__img {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-full);
  }

  .site-logo__text {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--text-lg);
    color: var(--color-primary-dark);
  }

  /* Nav Links */
  .nav-links {
    display: none;
    gap: var(--space-1);
  }

  .nav-link {
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 500;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-full);
    transition:
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
    color: var(--color-text-muted);
  }

  .nav-link:hover {
    background-color: var(--color-primary-50);
    color: var(--color-primary);
  }

  .nav-link.active {
    background-color: var(--color-primary-100);
    color: var(--color-primary-dark);
    font-weight: 600;
  }

  /* CTA Button */
  .nav-cta {
    display: none;
    font-size: var(--text-xs);
    padding: var(--space-2) var(--space-3);
  }

  /* Mobile Toggle */
  .nav-toggle {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: var(--space-2);
    cursor: pointer;
  }

  .nav-toggle__bar {
    display: block;
    width: 22px;
    height: 2px;
    background-color: var(--color-text);
    border-radius: var(--radius-full);
    transition:
      transform var(--duration-normal) var(--ease-out),
      opacity var(--duration-fast) var(--ease-out);
  }

  .nav-toggle[aria-expanded="true"] .nav-toggle__bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .nav-toggle[aria-expanded="true"] .nav-toggle__bar:nth-child(2) {
    opacity: 0;
  }

  .nav-toggle[aria-expanded="true"] .nav-toggle__bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Mobile Menu Open State */
  .nav-links.open {
    display: flex;
    flex-direction: column;
    position: absolute;
    top: 64px;
    left: 0;
    right: 0;
    background-color: var(--color-surface);
    padding: var(--space-4);
    border-bottom: 1px solid var(--color-border);
    box-shadow: var(--shadow-lg);
    gap: var(--space-1);
  }

  .nav-links.open .nav-link {
    padding: var(--space-3);
    font-size: var(--text-base);
  }

  /* Desktop */
  @media (min-width: 768px) {
    .site-nav {
      height: 72px;
    }

    .nav-links {
      display: flex;
    }

    .nav-cta {
      display: inline-flex;
    }

    .nav-toggle {
      display: none;
    }

    .site-logo__img {
      width: 48px;
      height: 48px;
    }
  }
</style>

<script>
  // Mobile nav toggle
  const toggle = document.getElementById('nav-toggle');
  const links = document.getElementById('nav-links');

  if (toggle && links) {
    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!isOpen));
      links.classList.toggle('open');
    });
  }

  // Sticky header shadow on scroll
  const header = document.getElementById('site-header');
  if (header) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        header.classList.toggle('scrolled', !entry.isIntersecting);
      },
      { threshold: 1.0 }
    );

    const sentinel = document.createElement('div');
    sentinel.style.height = '1px';
    sentinel.style.position = 'absolute';
    sentinel.style.top = '0';
    document.body.prepend(sentinel);
    observer.observe(sentinel);
  }
</script>
